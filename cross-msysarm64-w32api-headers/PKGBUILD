# Maintainer: Mayank Agrawal <mayagr@qti.qualcomm.com>

pkgname="cross-msysarm64-w32api-headers"
pkgver=13.0.0
pkgrel=8
pkgdesc="Win32 API headers for aarch64-pc-cygwin sysroot (WoA)"
arch=('x86_64')
url="https://github.com/Windows-on-ARM-Experiments/mingw-woarm64"
license=('custom')
options=('!strip' '!buildflags')

makedepends=("git" "autotools")

source=(
  "mingw-w64::git+https://github.com/Windows-on-ARM-Experiments/mingw-woarm64.git"
  0001-basetsd-aarch64-64bit-pointers.patch
)

sha256sums=('SKIP'
            'SKIP')

_target=aarch64-pc-cygwin
_sysroot=/usr/${_target}

prepare() {
  cd ${srcdir}/mingw-w64
  # guard the 64-bit-pointer INT_PTR/LONG_PTR/HANDLE_PTR typedefs on
  # __aarch64__ as well as _WIN64, since the GNU aarch64-pc-cygwin toolchain does
  # not predefine _WIN64. A named, reviewable, upstreamable patch.
  git apply --whitespace=fix \
    "${srcdir}"/0001-basetsd-aarch64-64bit-pointers.patch
}


build() {
  mkdir -p ${srcdir}/headers-build
  cd ${srcdir}/headers-build

  # --enable-w32api: install the Win32 API headers under PREFIX/include/w32api
  # (shorthand that also sets --disable-crt).
  ${srcdir}/mingw-w64/mingw-w64-headers/configure \
    --prefix=${_sysroot} \
    --host=${_target} \
    --build=${CHOST} \
    --enable-sdk=all \
    --enable-idl \
    --enable-w32api \
    --with-default-win32-winnt=0x0A00 \
    --with-default-msvcrt=msvcrt

  make
}

package() {
  cd ${srcdir}/headers-build

  # Install to sysroot/usr (standard prefix install)
  make DESTDIR=${pkgdir} install

  echo "--- cross-msysarm64-w32api-headers check (headers under include/w32api) ---"
  [ -f ${pkgdir}${_sysroot}/include/w32api/windows.h ] && \
    echo "include/w32api/windows.h OK" || echo "WARNING: include/w32api/windows.h MISSING"
  [ -f ${pkgdir}${_sysroot}/include/w32api/ntstatus.h ] && \
    echo "include/w32api/ntstatus.h OK" || echo "WARNING: include/w32api/ntstatus.h MISSING"
}