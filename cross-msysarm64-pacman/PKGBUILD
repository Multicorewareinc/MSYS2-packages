# Maintainer: Alexey Pavlov <alexpux@gmail.com>
# Contributor: Martell Malone <martellmalone@gmail.com>
# Contributor: Ray Donnelly <mingw.android@gmail.com>
#
# aarch64-pc-msys build of pacman, staged into the cross sysroot.  This is also
# what provides makepkg, repo-add and the rest of the packaging tools.
#
# Sources, all 35 patches and the config files are taken unchanged from the
# native pacman/ recipe.  See build() for how the meson cross build differs from
# it and from the tested standalone script.

_target=aarch64-pc-msys
_sysroot=/usr/${_target}

pkgbase=pacman
pkgname=cross-msysarm64-pacman
pkgver=6.1.0
pkgrel=25
pkgdesc="A library-based package manager with dependency support (MSYS2 port) (${_target})"
arch=('x86_64')
url="https://www.archlinux.org/pacman/"
msys2_repository_url="https://github.com/msys2/msys2-pacman"
msys2_references=(
  "cpe: cpe:/a:pacman_project:pacman"
)
license=('spdx:GPL-2.0-or-later')
groups=('cross-msysarm64')
options=('!strip' 'staticlibs')
# Retargeted at this chain's packages.  The native recipe also depends on gnupg,
# pacman-mirrors, msys2-keyring and which; none of those has a cross-msysarm64
# package yet, so they are recorded here rather than depended on:
#   gnupg           - pacman-key, and package signature verification
#   pacman-mirrors  - /etc/pacman.d/mirrorlist*
#   msys2-keyring   - the distribution keys pacman-key imports
#   which           - used by makepkg at run time
depends=('cross-msysarm64-bash'
         'cross-msysarm64-curl'
         'cross-msysarm64-libarchive'
         'cross-msysarm64-gpgme'
