         'cross-msysarm64-gettext'
         'cross-msysarm64-bzip2'
         'cross-msysarm64-xz'
         'cross-msysarm64-zstd'
         'cross-msysarm64-runtime-devel')
makedepends=('cross-msysarm64-gcc'
             'cross-msysarm64-binutils'
             'meson'
             'ninja'
             'git')
_commit="e3dc296ba35d5039775c6e53decc7296b3bce396"
