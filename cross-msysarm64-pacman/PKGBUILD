apply_git_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying $_patch"
    git apply "${srcdir}/${_patch}"
  done
}

prepare() {
  # ${pkgbase}, not the native recipe's ${pkgname}: the source directory is
  # named by the git source's "pacman::" prefix, which follows pkgbase, while
  # pkgname here is cross-msysarm64-pacman.
  cd ${srcdir}/${pkgbase}

  # fixup symlinks
  git config core.symlinks true
  git reset HEAD --hard

 apply_git_with_msg 0001-makepkg-clean-up-more-things.patch \
  0002-makepkg-build-env-export.patch \
  0003-fill_progress.patch \
  0004-test-fixes.patch \
  0005-Remove-everything-related-to-sudo-fakeroot-file-perm.patch \
  0006-change-shebang.patch \
  0007-Set-fixed-paths-for-various-tools.patch \
  0008-makepkg-port-staticlibs-to-Windows.patch \
  0009-makepkg-port-strip-debug-to-Windows.patch \
  0010-makepkg-lint_package-Warn-on-package-files-referenci.patch \
  0011-Core-update.patch \
  0012-Remove-ldconfig.patch \
  0013-Change-the-epoch-separator.patch \
  0014-makepkg-avoid-creating-.tar-files-with-extended-attr.patch \
  0015-pacman-libalpm-ignore-file-conflicts-for-foo.exe-foo.patch \
  0016-Change-default-answer-of-all-queries-to-yes.patch \
  0017-Use-pipe-instead-of-socket.patch \
  0018-pacman-make-file-list-comparisons-between-packages-c.patch \
  0019-Workaround-compressing-packages-with-bsdtar-under-Ac.patch \
  0020-Fix-asciidoc-argparse.patch \
  0021-Export-CC-and-CXX-variables-explicitly.patch \
  0022-pacman.c-handle-cr-on-stdin-as-well.patch \
  0023-Fix-building-staticlibs-with-LTO.patch \
  0024-Make-lint_pkgbuild-opt-in-via-MAKEPKG_LINT_PKGBUILD-.patch \
  0025-pacman-key-pass-allow-weak-key-signatures-during-imp.patch \
  0026-Disable-autodep-scripts.patch \
  0027-Fix-read-after-free-issue-parsing-config-files.patch \
  0028-Fetch-signature-and-database-from-the-same-URL.patch \
  0029-libmakepkg-remove-MAKEFLAGS-from-buildenv_vars.patch \
  0030-libmakepkg-do-not-unset-CHOST-with-buildflags.patch \
  0031-repo-add-unconditionally-create-the-database-if-it-i.patch \
  0032-Translate-MSYS2-specific-messages-into-Japanese.patch \
  0033-fixup-Core-update.patch \
  0034-pacman-key-disable-WKD-by-default.patch

  # curl 8.20 compat: https://gitlab.archlinux.org/pacman/pacman/-/merge_requests/361
  apply_git_with_msg 361.patch
}

build() {
  cd ${srcdir}/${pkgbase}

  # MSYSTEM=MSYS, not the CYGWIN this chain uses elsewhere.  meson here is the
  # msys2 python build, and it refuses to start under any other value:
  #     ERROR: This python3 seems to be msys/python on MSYS2 Windows, but you
  #            are in a MinGW environment
  export MSYSTEM=MSYS

  # Appended, never prepended - see cross-msysarm64-xz for why.
  PATH="${PATH}:${_sysroot}/bin:${_sysroot}/usr/bin"
  export PATH

  # The standalone script copies every .pc file from ${_sysroot}/usr/lib/pkgconfig
  # into ${_sysroot}/lib/pkgconfig before configuring, because it installs its
  # dependencies under the bare sysroot.  Not needed here: everything in this
  # chain installs under ${_sysroot}/usr, and the makepkg profile already points
  # PKG_CONFIG_LIBDIR at ${_sysroot}/usr/lib/pkgconfig.

  # meson has no --host; a cross file is how the toolchain is described.
  # system='cygwin' rather than 'msys' is the script's, and is right for the
  # same reason the autotools packages use the cygwin triplet: meson keys its
  # Windows and shared-library behaviour off this name and does not know 'msys'.
  cat > cross_file.txt <<EOF
[binaries]
c = '${_target}-gcc'
cpp = '${_target}-g++'
ar = '${_target}-ar'
strip = '${_target}-strip'
pkgconfig = 'pkg-config'

[host_machine]
system = 'cygwin'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[built-in options]
c_args = ['-O0', '-g', '-specs=${_SPECS}']
cpp_args = ['-O0', '-g', '-specs=${_SPECS}']
c_link_args = ['-static-libgcc', '-specs=${_SPECS}', '-Wl,--disable-high-entropy-va', '-L${_sysroot}/lib/w32api', '-Wl,-u,__emutls_get_address', '-lgcc_eh']
cpp_link_args = ['-static-libgcc', '-specs=${_SPECS}', '-Wl,--disable-high-entropy-va', '-L${_sysroot}/lib/w32api', '-Wl,-u,__emutls_get_address', '-lgcc_eh']
EOF

  # -L${_sysroot}/lib/w32api is this recipe's, not the script's, and replaces
  # the script's worst workaround.  The Win32 import libraries live in
  # ${_sysroot}/lib/w32api, which is not on the linker's search path: the specs
  # file adds the w32api *include* directory with -idirafter, but nothing adds
  # the library one.  Rather than fix that, the script does
  #
  #     for lib in gdi32 winspool ole32 oleaut32 uuid comdlg32 ... ; do
  #       aarch64-pc-msys-ar rcs "${SYSROOT}/lib/lib${lib}.a"
  #     done
  #
  # which creates eight-byte archives containing nothing.  -lgdi32 then
  # resolves, to an empty library - so a call into any of them fails to link
  # with a confusing error, or is quietly satisfied by something else.  The
  # stubs also stay in the sysroot owned by no package, silently answering
  # -lgdi32 for everything built afterwards.  Pointing -L at the directory the
  # import libraries are actually in gets the real 770 KB libgdi32.a.
  #
  # -Wl,-u,__emutls_get_address together with -lgcc_eh is the same toolchain
  # defect that cross-msysarm64-gpgme documents, reaching pacman through the
  # static libgpgme.a it links:
  #
  #     libgpgme.a(debug.o): undefined reference to `__emutls_get_address'
  #
  # aarch64-pc-msys gcc uses emulated TLS but ships __emutls_get_address in
  # libgcc_eh.a rather than libgcc.a, and the specs file carries a plain
  # "*libgcc: -lgcc".  Every consumer of a static library holding a __thread
  # variable inherits the problem, not just the library itself.
  #
  # -lgcc_eh alone would not fix it here.  meson puts c_link_args before the
  # -Wl,--start-group block that holds libalpm.a and the dependency archives, so
  # ld reaches libgcc_eh.a while nothing is undefined yet, takes nothing from
  # it, and only afterwards discovers the reference.  -u makes the symbol
  # undefined from the start, so emutls.o is pulled in when libgcc_eh.a is
  # scanned.
  #
  # --prefix, --sysconfdir and --localstatedir all stay under ${_sysroot}, as
  # everywhere in this chain.  These are install paths as well as lookup paths:
  # with the bare /etc and /var that the target would want at run time, meson
  # stages /etc/pacman.conf, /etc/makepkg.conf, /var/lib/pacman and
  # /var/cache/pacman/pkg into ${pkgdir} directly, and installing the package
  # then overwrites the *host's* pacman and makepkg configuration.  Relocating
  # to the real root is a deployment step, the same one --prefix already needs.
  #
  # --default-library=static -Dbuildstatic=true comes from both the script and
  # the native recipe: libalpm is linked into pacman rather than shipped as a
  # DLL, so there is no msys-alpm DLL to check for here.
  #
  # doc and doxygen are disabled because asciidoc and doxygen are not installed
  # here; the native recipe enables both.  Consequence: no man pages and no
  # libalpm HTML documentation.  -Di18n=false is the script's, so pacman's
  # messages are English only.
  #
  # -Dpkg-ext and -Dscriptlet-shell are the native recipe's values, kept.
  meson setup build \
    --cross-file cross_file.txt \
    --buildtype=plain \
    --prefix=${_sysroot}/usr \
    --sysconfdir=${_sysroot}/etc \
    --localstatedir=${_sysroot}/var \
    --default-library=static \
    -Dbuildstatic=true \
    -Ddoc=disabled \
    -Ddoxygen=disabled \
    -Di18n=false \
    -Dgpgme=enabled \
    -Dcurl=enabled \
    -Duse-git-version=false \
    -Dpkg-ext=.pkg.tar.xz \
    -Dscriptlet-shell=/usr/bin/bash

  meson compile -C build

  # meson lays the build tree out flat, so this is build/pacman.exe rather than
  # the build/src/pacman/pacman.exe the source layout would suggest.
  [[ -f build/pacman.exe ]] || {
    error "pacman.exe was not produced"; return 1
  }
}

package() {
  cd ${srcdir}/${pkgbase}
  DESTDIR=${pkgdir} meson install -C build

  # The config files, as the native recipe installs them, but under the sysroot.
  install -dm755 ${pkgdir}${_sysroot}/etc
  install -m644 ${srcdir}/pacman.conf ${pkgdir}${_sysroot}/etc/pacman.conf
  install -m644 ${srcdir}/makepkg.conf ${pkgdir}${_sysroot}/etc/
  install -m644 ${srcdir}/makepkg_mingw.conf ${pkgdir}${_sysroot}/etc/
  install -dm755 ${pkgdir}${_sysroot}/etc/makepkg_mingw.d
  local f
  for f in "${srcdir}/"makepkg_mingw.d.*.conf; do
    install -m644 "${f}" "${pkgdir}${_sysroot}/etc/makepkg_mingw.d/${f#${srcdir}/makepkg_mingw.d.}"
  done
  install -m755 ${srcdir}/makepkg-mingw ${pkgdir}${_sysroot}/usr/bin/

  # Fixup .pc file, as the native recipe does.
  sed -i "s|/usr/.*libintl.a|-lintl|g" ${pkgdir}${_sysroot}/usr/lib/pkgconfig/libalpm.pc

  # The native recipe fills these in from a CARCH case that knows only i686 and
  # x86_64.  CARCH is the *package* architecture here - x86_64, because this is
  # a host-side cross package - so that case would stamp the target's
  # makepkg.conf with x86_64-pc-cygwin.  The values wanted are the target's.
  sed -i ${pkgdir}${_sysroot}/etc/makepkg.conf \
    -e "s|@CARCH[@]|aarch64|g" \
    -e "s|@CHOST[@]|${_target%-msys}-cygwin|g" \
    -e "s|@CARCHFLAGS[@]||g"

  [[ -f ${pkgdir}${_sysroot}/usr/bin/pacman.exe ]] || {
    error "pacman.exe was not installed"; return 1
  }
  [[ -f ${pkgdir}${_sysroot}/usr/bin/makepkg ]] || {
    error "makepkg was not installed"; return 1
  }
}
