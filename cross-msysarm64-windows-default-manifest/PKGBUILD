# Maintainer: Mayank Agrawal <mayagr@qti.qualcomm.com>
#
# Default Windows application manifest for the aarch64-pc-cygwin cross sysroot.
#
# This is the aarch64 counterpart of the x64 `windows-default-manifest` package
# (in-tree, and shipped by upstream MSYS2 as msys/windows-default-manifest,
# which owns /usr/lib/default-manifest.o). Both build the same upstream
# cygwin-apps source; the only difference is the install prefix and the windres
# used.
#
# WHY THIS PACKAGE EXISTS
# ----------------------------------
# GCC's built-in spec appends default-manifest.o to EVERY non-shared link:
#
#     %{!shared:%:if-exists(default-manifest.o%s)}
#
# The `if-exists` guard resolves the name against the COMPILER search path
# (%s), but the bare filename is what gets handed to ld. When the file is not in
# the sysroot the guard still passes and every link then dies with
#
#     ld: cannot find default-manifest.o: No such file or directory
#
# Because autoconf's compiler probe both compiles AND links, that surfaces as
# the badly misleading "could not find a working compiler" -- which is how it
# presented when it blocked the whole userland seed at its first package (gmp).
#
# The x64 target has always shipped this file, so its links work. The aarch64
# sysroot never packaged it: it was hand-placed during early bring-up (pacman
# -Qo reported no owner), so the gcc-15.0.1-2 -> -3 rebuild simply stopped
# inheriting the stale file and exposed the gap. Packaging it restores x64
# parity rather than diverging from it -- the alternative (patching the spec to
# drop the reference) would silently strip the default manifest (asInvoker
# privileges, supportedOS compatibility GUIDs) from every ARM64 executable.
#
# The x64 object is NOT reusable: it is pe-x86-64 while the target needs
# pe-aarch64-little (the two differ from byte 2).

pkgname="cross-msysarm64-windows-default-manifest"
pkgver=6.4
pkgrel=1
pkgdesc="Default Windows application manifest for aarch64-pc-cygwin sysroot (WoA)"
arch=('x86_64')
url='https://sourceware.org/git/cygwin-apps/windows-default-manifest.git'
license=('BSD')
options=('!strip' '!buildflags' '!emptydirs')
# The cross binutils supplies aarch64-pc-cygwin-windres, which is the only tool
# this build needs (upstream's Makefile is a single windres invocation).
makedepends=(
  "git"
  "autotools"
  "cross-msysarm64-binutils"
)
_GIT_TAG="release-${pkgver//\./_}"
source=("git://sourceware.org/git/cygwin-apps/windows-default-manifest.git#tag=${_GIT_TAG}")
sha256sums=('SKIP')
msys2_references=(
  'cygwin: windows-default-manifest'
)

_target=aarch64-pc-cygwin
_sysroot=/usr/${_target}

prepare() {
  cd "${srcdir}/windows-default-manifest"

  autoreconf -fiv
}

build() {
  cd "${srcdir}/windows-default-manifest"

  WINDRES=${_target}-windres \
  ./configure \
    --prefix=${_sysroot} \
    --build=${CHOST} \
    --host=${_target}

  make RC_FLAGS='--preprocessor=gcc --preprocessor-arg=-E --preprocessor-arg=-xc --preprocessor-arg=-DRC_INVOKED'
}

package() {
  cd "${srcdir}/windows-default-manifest"

  # Lands ${pkgdir}/usr/aarch64-pc-cygwin/lib/default-manifest.o -- the
  # cross-sysroot analogue of x64's /usr/lib/default-manifest.o.
  make DESTDIR="${pkgdir}" install

  echo "--- cross-msysarm64-windows-default-manifest check ---"
  local _o="${pkgdir}${_sysroot}/lib/default-manifest.o"
  if [ ! -f "${_o}" ]; then
    echo "  ERROR: default-manifest.o MISSING from ${_sysroot}/lib"
    return 1
  fi
  echo "  default-manifest.o OK"
  # Guard the arch explicitly: a host-windres slip would silently produce a
  # pe-x86-64 object that ld would then reject on every ARM64 link.
  if ${_target}-objdump -f "${_o}" 2>/dev/null | grep -q 'pe-aarch64-little'; then
    echo "  format pe-aarch64-little OK"
  else
    echo "  ERROR: wrong object format:"
    ${_target}-objdump -f "${_o}" 2>&1 | sed -n '2,3p'
    return 1
  fi
}
