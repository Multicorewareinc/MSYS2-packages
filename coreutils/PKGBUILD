# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=coreutils
pkgver=8.32
pkgrel=5
pkgdesc="The basic file, shell and text manipulation utilities of the GNU operating system"
arch=('i686' 'x86_64' 'aarch64')
license=('GPL3')
url="https://www.gnu.org/software/coreutils"
msys2_references=(
  "cpe: cpe:/a:gnu:coreutils"
)
depends=('gmp' 'libiconv' 'libintl')
makedepends=('groff' 'gmp-devel' 'libiconv-devel' 'gettext-devel' 'help2man' 'autotools' 'gcc')
source=(https://ftp.gnu.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.xz{,.sig}
        001-coreutils-8.30.patch
        002-coreutils-8.32-enable-stdbuf.patch
        003-coreutils-8.32-fix-test-cases.patch
        004-msystem-osname-cygwin.patch)
sha256sums=('4458d8de7849df44ccab15e16b1548b285224dbba5f08fac070c1c0e0bcc4cfa'
            'SKIP'
            '467bde24da0ccea48260f58d3c94a84de4e027ab598a926003642f791da47ca2'
            'e3be62b9aceb3231f09f05bc3bd8b18f6aaa495f5063781cdd261d560a7e80d0'
            'ad9e0582373500c0668e38483401169f48d6a2f8ad8d28ef8e7b06e4a3e08a74'
            '3922afd54b2323772f5cbd0638d0887ef858199bbaf4076a1db318173021c3dc')
validpgpkeys=('6C37DC12121A5006BC1DB804DF6FD971306037D9')

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}

  patch -p1 -i ${srcdir}/001-coreutils-8.30.patch
  patch -p1 -i ${srcdir}/002-coreutils-8.32-enable-stdbuf.patch
  patch -p1 -i ${srcdir}/003-coreutils-8.32-fix-test-cases.patch

  # https://github.com/msys2/MSYS2-packages/issues/3012
  patch -p1 -i ${srcdir}/004-msystem-osname-cygwin.patch

  autoreconf -fi

  # coreutils is not a libtool consumer: 8.32's configure.ac has no LT_INIT, so
  # autoreconf never runs libtoolize and there is no ltmain.sh to patch. Passing
  # one anyway would trip fix_msys_libtool's `[ -f ]` guard. `configure` is
  # still passed (a no-op today) so the helper's own warning keeps watch if that
  # changes.
  source "${startdir}/../.ci/fix-msys-libtool.sh"
  fix_msys_libtool configure

  # If a future coreutils DOES adopt libtool, silently not patching ltmain.sh
  # would degrade the build to static-only with no error. Fail loudly instead.
  if [[ -n $(find . -maxdepth 3 -name ltmain.sh -type f -print -quit) ]]; then
    echo "==> ERROR: coreutils now ships an ltmain.sh -- it has become a libtool" >&2
    echo "    consumer, so restore it to the fix_msys_libtool call above." >&2
    return 1
  fi
  echo "==> ok: coreutils uses no libtool; configure patched, no ltmain.sh expected"
}

build() {
  [[ -d ${srcdir}/build-${CHOST} ]] && rm -rf ${srcdir}/build-${CHOST}
  mkdir -p ${srcdir}/build-${CHOST} && cd ${srcdir}/build-${CHOST}

  export gl_cv_have_weak=no

  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    # Cross-build for aarch64-pc-msys (see .ci/makepkg-aarch64-cross.conf).
    # Links gmp/libiconv/libintl staged under the toolchain sysroot at
    # /usr/aarch64-pc-msys/usr. GCC-15 too new for some gnulib TUs: -std=gnu17.
    # The gl_cv_* answers pin gnulib AC_TRY_RUN probes that can't run cross.
    #
    # -D_HAVE_LONG_DOUBLE: src/sort.c calls strtold(), which the sysroot HEADER
    #   hides -- stdlib.h guards the prototype on _HAVE_LONG_DOUBLE, which
    #   newlib's configure emits into newlib.h, and in the cross sysroot that
    #   file is a 94-byte stub (native x86_64 ships 11811 bytes with the macro
    #   defined). The function is present in the target libc; only the
    #   declaration is missing. Same stub-header defect that hides wcwidth via
    #   _newlib_version.h. Remove once the sysroot ships a real newlib.h.
    ../${pkgname}-${pkgver}/configure \
      --build=${CHOST} \
      --host=aarch64-pc-msys \
      --prefix=/usr \
      --libexecdir=/usr/lib \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --program-transform-name=s/kill/gkill/ \
      --without-libintl-prefix \
      --without-libiconv-prefix \
      --enable-install-program=arch,hostname \
      --enable-no-install-program=uptime \
      gl_cv_func_strtod_works=yes \
      gl_cv_func_strtold_works=yes \
      CFLAGS="-std=gnu17 -D_HAVE_LONG_DOUBLE -I/usr/aarch64-pc-msys/usr/include" \
      LDFLAGS="${LDFLAGS} -L/usr/aarch64-pc-msys/usr/lib"

    # src/local.mk carries a maintainer rule that regenerates src/primes.h by
    # RUNNING src/make-prime-list$(EXEEXT) -- a binary this build links for
    # aarch64, not for the build host. The rule has no prerequisites, so it only
    # fires when the file is absent, and 8.32 ships it pregenerated. Assert that,
    # so a future tarball dropping it fails here instead of executing a foreign
    # binary mid-build.
    if [[ ! -s ../${pkgname}-${pkgver}/src/primes.h ]]; then
      echo "==> ERROR: src/primes.h missing/empty -- make would regenerate it by" >&2
      echo "    running the cross-built src/make-prime-list.exe on the build host." >&2
      return 1
    fi

    # GCC-15's integrated preprocessor loops indefinitely compiling
    # lib/mountlist.c, spinning cc1 at 100% CPU. Separate cpp and cc1 passes each
    # finish in seconds and it hangs at -O0, -O1 and -O2 alike, so this is the
    # cpp/cc1 fusion rather than a code-gen loop. Same cc1 defect the runtime
    # hits on the winsup.h+iphlpapi header chain; see
    # msys2-runtime-aarch64-stage-2/PKGBUILD:470 for the same remedy. -C is
    # required alongside it, since the separate cpp pass would otherwise strip
    # the comments gnulib's /*FALLTHRU*/ markers rely on.
    #
    # Scoped to $CC here rather than the shared cross conf: only coreutils is
    # known to trip it, and a global flag would mask further instances. V=1 and
    # -j1 keep the last log line equal to the failing command, and the timeout
    # caps a recurrence at minutes. Remove once the toolchain ships a fixed cc1.
    local _to=45m _rc=0
    timeout --foreground -k 30s ${_to} make V=1 -j1 \
      CC="aarch64-pc-msys-gcc -no-integrated-cpp -C" || _rc=$?
    if [[ ${_rc} -ne 0 ]]; then
      if [[ ${_rc} -eq 124 || ${_rc} -eq 137 ]]; then
        echo "==> STALLED: make exceeded ${_to} with no progress." >&2
        echo "    The last command echoed above is the one that stalls." >&2
        echo "    If it is a compile, suspect the integrated-cpp loop again." >&2
      fi
      return 1
    fi
    return
  fi

  ../${pkgname}-${pkgver}/configure \
    --build=${CHOST} \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --program-transform-name=s/kill/gkill/ \
    --without-libintl-prefix \
    --without-libiconv-prefix \
    --enable-install-program=arch,hostname \
    --enable-no-install-program=uptime \
    gl_cv_func_strtod_works=yes \
    gl_cv_func_strtold_works=yes

  make
}

check() {
  # target binaries can't run on the x64 (emulated) cross host
  [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]] && return 0
  cd ${srcdir}/build-${CHOST}
  make check
}

package() {
  cd ${srcdir}/build-${CHOST}
  make DESTDIR=${pkgdir} install

  test ! -f ${pkgdir}/usr/lib/coreutils/libstdbuf.so.exe ||
  mv ${pkgdir}/usr/lib/coreutils/libstdbuf.so.exe \
    ${pkgdir}/usr/lib/coreutils/libstdbuf.dll

  install -Dm644 ${srcdir}/${pkgname}-${pkgver}/src/dircolors.hin ${pkgdir}/etc/DIR_COLORS
}
