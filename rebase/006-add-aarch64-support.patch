 db_file_x86_64="@sysconfdir@/rebase.db.x86_64"
+db_file_aarch64="@sysconfdir@/rebase.db.aarch64"
+# the 64 bit database: rebase -8 picks the one for the machine it runs on
+case `uname -m` in
+    aarch64) db_file_64="${db_file_aarch64}" ;;
+    *)       db_file_64="${db_file_x86_64}" ;;
+esac
