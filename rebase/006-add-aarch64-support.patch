diff --git a/rebaseall.in b/rebaseall.in
index 70a471a..003d669 100644
--- a/rebaseall.in
+++ b/rebaseall.in
@@ -65,15 +65,21 @@ FileList="${DefaultFileList}"
 Suffixes="${DefaultSuffixes}"
