# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=nano
pkgver=9.3
pkgrel=2
pkgdesc="Pico editor clone with enhancements"
arch=('i686' 'x86_64' 'aarch64')
license=('spdx:GPL-3.0-or-later')
url="https://www.nano-editor.org"
msys2_repository_url="https://cgit.git.savannah.gnu.org/cgit/nano.git"
msys2_changelog_url="https://www.nano-editor.org/news.php"
msys2_references=(
  "anitya: 2046"
  "archlinux: nano"
  "cpe: cpe:/a:gnu:nano"
  "gentoo: app-editors/nano"
)
groups=('editors')
depends=('file' 'libintl' 'ncurses' 'sh')
makedepends=('autotools'
             'gcc'
             'ncurses-devel'
             'libiconv-devel'
             'gettext-devel')
backup=('etc/nanorc')
source=(https://www.nano-editor.org/dist/v9/${pkgname}-${pkgver}.tar.xz{,.asc})
sha256sums=('a9affc52c9596ee0682bcdd4ceb3c0b235eb221d83d733dfd9b0dff45897cb0d'
            'SKIP')
validpgpkeys=(
  '168E6F4297BFD7A79AFD4496514BBE2EB8E1961F' # Benno Schulenberg <bensberg@telfort.nl>
)

prepare() {
  cd "${pkgname}-${pkgver}"

  autoreconf -vfi
}

build() {
  cd ${srcdir}/${pkgname}-${pkgver}
  # aarch64-pc-cygwin cross: --host selects the cross compiler; the
  # libraries it links come from the toolchain sysroot.  Without the
  # --without-lib*-prefix options gettext's configure looks for libintl
  # under the install prefix, finds the host /usr/lib/libintl.dll.a, fails
  # to link it and quietly builds without translations.
  local _xargs=(--build=${CHOST})
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _xargs+=(--host=aarch64-pc-cygwin
             --without-libintl-prefix --without-libiconv-prefix)
    CPPFLAGS+=" -I/usr/aarch64-pc-cygwin/usr/include"
    LDFLAGS+=" -L/usr/aarch64-pc-cygwin/usr/lib"
  fi

  ./configure "${_xargs[@]}" \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-color \
    --enable-nanorc \
    --enable-utf8

  make
}

package() {
  cd ${srcdir}/${pkgname}-${pkgver}
  make DESTDIR=${pkgdir} install
  install -DTm644 ${srcdir}/${pkgname}-${pkgver}/doc/sample.nanorc ${pkgdir}/etc/nanorc
}
