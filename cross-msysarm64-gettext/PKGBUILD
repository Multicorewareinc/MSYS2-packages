prepare() {
  cd "${srcdir}/${pkgbase}-${pkgver}"

  # Cygwin patches
  patch -p1 -i $srcdir/gettext-tools-tests-locale-ll-es.patch
  patch -p1 -i $srcdir/gettext-0.21.1-autopoint-V.patch
  patch -p1 -i $srcdir/gettext-0.21.1-cygwin-ftm.patch
  patch -p1 -i $srcdir/gettext-0.22-no-woe32dll-gettext-tools-configure-ac.patch
  patch -p1 -i $srcdir/gettext-0.22-no-woe32dll-m4-woe32-dll-m4.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-gnulib-lib-localcharset-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-gnulib-lib-localename-h.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-gnulib-lib-localename-unsafe-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localcharset-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-h.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-unsafe-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-tools-gnulib-lib-localcharset-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-tools-gnulib-lib-localename-h.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-tools-gnulib-lib-localename-unsafe-c.patch
  patch -p1 -i $srcdir/gettext-0.22-disable-libtextstyle.patch

  # MSYS2 patch
  patch -p1 -i $srcdir/gettext-0.19.8.1-msys2.patch

  pushd gettext-tools/misc > /dev/null
    mkdir archive
    tar -xvf archive.dir.tar -C archive
    rm -f archive.dir.tar
    pushd archive > /dev/null
      patch -p1 -i ${srcdir}/gettext-0.19.7-archive.patch
      tar -cvf ../archive.dir.tar *
    popd > /dev/null
    rm -rf archive
  popd > /dev/null

  libtoolize --copy --force
  ./autogen.sh --skip-gnulib
}

build() {
  # Fail fast if makepkg was run without --config crossarm64/makepkg-crossarm64.conf.
  # Otherwise CC comes from /etc/makepkg.conf (=gcc) and the whole package builds as
  # native x86_64 while still claiming --host=aarch64-pc-msys.  See guard.sh.
  source "${startdir}/../crossarm64/guard.sh"
  crossarm64_assert_env

  cd "${srcdir}/${pkgbase}-${pkgver}"

  # The native recipe rewrites the host triplet -msys -> -cygwin here, and this
  # follows it.  gettext's configury and its bundled gnulib recognise cygwin*
  # but not msys*, which is precisely what made gettext the hardest package in
  # the earlier hand build: intl/configure had to be patched in 19 places and
  # its libtool came out with build_libtool_libs=no, producing libintl.a and no
  # DLL at all.  Saying cygwin avoids all of that, and the MSYS2 patches below
  # keep the msys- DLL naming.
  local _triplet="${_target%-msys}-cygwin"

  # Native for the target rather than cross, for the reason documented in
  # cross-msysarm64-bash: with --host != --build autoconf skips every
  # AC_RUN_IFELSE and guesses.  gnulib leans on those probes far harder than
  # bash does, so guesses here would be especially costly.  CC/AR/... come from
  # the makepkg profile, so the triplet cannot redirect tool lookup.

  # The sysroot bin directories are APPENDED, never prepended: they are on PATH
  # only so that binaries compiled during configure can load msys-2.0.dll, and
  # PATH order does not affect that.  Prepending them shadows the host's tools
  # with target ones - once cross-msysarm64-sed is installed, a prepended
  # sysroot bin makes configure run the aarch64 sed instead of the host's, and
  # config.status then fails with "Something went wrong bootstrapping makefile
  # fragments for automatic dependency tracking".
  PATH="${PATH}:${_sysroot}/bin:${_sysroot}/usr/bin"
  export PATH

  # CFLAGS works around *two* separate internal compiler errors in the cross
  # gcc, both on the same file - gettext-runtime/intl/gnulib-lib/vasnwprintf.c,
  # which includes the ~7000-line vasnprintf.c.  Each was bisected by compiling
  # that one file directly rather than guessing:
  #
  #   -fno-tree-ccp   "during GIMPLE pass: ccp", after which cc1 wedges - it
  #                   never finishes printing the diagnostic and sits blocked
  #                   burning no CPU until killed, so the build appears to hang
  #                   rather than fail.  -O0 compiles, -O1 reproduces it,
  #                   -O2 -fno-tree-ccp compiles: it is that one pass, not the
  #                   optimisation level, so -O2 is kept everywhere else.
  #
  #   no -g           "during RTL pass: vartrack - internal compiler error:
  #                   Segmentation fault".  Variable tracking only runs when
  #                   generating debug info, so dropping -g avoids it;
  #                   -g -O2 -fno-tree-ccp still ICEs, -O2 -fno-tree-ccp is
  #                   clean.  Nothing here needs debug info: the profile sets
  #                   !strip only because the host strip cannot read aarch64
  #                   objects.
  #
  # The compiler is "aarch64-pc-msys-gcc (GCC) 15.0.1 20250131 (experimental)",
  # a pre-release build, so this is worth retrying whenever the toolchain is
  # rebuilt from a newer GCC.
  #
  # --disable-libasprintf drops a small C++ convenience library that nothing in
  # this chain uses and that MSYS2 ships as its own package anyway (the native
  # recipe's pkgname array lists libasprintf separately from libintl).  It does
  # not link here: libtool drives the link with --tag=CC, so libstdc++ is never
  # pulled in and autosprintf.o is left with undefined std::ios_base::Init::
  # Init(), std::string::_Rep::_S_empty_rep_storage and __gxx_personality_seh0.
  # Worth revisiting if libasprintf is ever wanted, but it is not a libintl
  # dependency and should not block it.
  #
  # Relocation is left enabled, as in the native build.  intl hardcodes
  # -DDEPENDS_ON_LIBICONV=1 and its gnulib relocatable.c calls
  # libiconv_set_relocation_prefix(), so libiconv has to export that symbol;
  # cross-msysarm64-libiconv is built --enable-relocatable for exactly this
  # reason, matching the shipped MSYS2 msys-iconv-2.dll.
  ./configure \
    --build=${_triplet} \
    --host=${_triplet} \
    --prefix=${_sysroot}/usr \
    --with-included-libcroco \
    --with-included-libunistring \
    --with-included-libxml \
    --with-included-glib \
    --with-included-gettext \
    --without-emacs \
    --enable-shared \
    --enable-static \
    --disable-java \
    --disable-native-java \
    --disable-csharp \
    --disable-openmp \
    --disable-libasprintf \
    CFLAGS="-O2 -fno-tree-ccp"

  # Only gettext-runtime is built.  This package exists to provide libintl, and
  # gettext-tools is both unnecessary for that and actively harmful here:
  # compiling gettext-tools/gnulib-lib/uniname/uniname.c sends the cross gcc
  # into an infinite loop.  Not an ICE - cc1 spins, and was measured burning a
  # full core for eleven hours before being killed.  gettext-tools also pulls
  # in libasprintf, disabled above for a separate reason.
  make -C gettext-runtime

  # The failure that cost the most time in the hand build was libintl coming
  # out static-only: libtool sets build_libtool_libs=no, emits libintl.a with
  # dlname='' and no DLL, and nothing complains until a consumer fails on
  # undefined __imp_* symbols.  Fail here instead.
  local _la=gettext-runtime/intl/libintl.la
  grep -q "^dlname='.\+'" ${_la} 2>/dev/null || {
    error "libintl.la has no dlname - libtool produced a static-only libintl"
    return 1
  }

  # Relink libintl with an explicit DLL entry point.  The packaged cross gcc
  # names _cygwin_dll_entry in its specs, which nothing in this sysroot
  # defines, so ld warns "cannot find entry symbol" and emits a DLL with
  # AddressOfEntryPoint 0 that the runtime never initialises.  The native
  # msys-intl-8.dll has a real entry point; ours had 0 before this.  Same gcc
  # bug worked around in cross-msysarm64-ncurses.
  #
  # It is done as a targeted relink of just intl rather than via global
  # LDFLAGS, because gettext-runtime also links envsubst.exe, gettext.exe and
  # ngettext.exe, and forcing a DLL entry point on an executable would break
  # it.  intl builds only the library, so the override is safe there.
  rm -f gettext-runtime/intl/libintl.la gettext-runtime/intl/.libs/msys-intl-*.dll
  make -C gettext-runtime/intl \
       LDFLAGS="-Wl,-e,_msys_dll_entry -Wl,-u,_pei386_runtime_relocator"

  local _dll
  _dll=$(ls gettext-runtime/intl/.libs/msys-intl-*.dll 2>/dev/null | head -1)
  [[ -n ${_dll} ]] || { error "libintl DLL was not produced"; return 1; }
  local _entry
  _entry=$(${_target}-objdump -p "${_dll}" | awk '/AddressOfEntryPoint/{print $2}')
  [[ ${_entry} =~ ^0+$ ]] && {
    error "libintl DLL has entry point 0 - it would load but never initialise"
    return 1
  }

  make -C gettext-runtime DESTDIR="${srcdir}/dest" install
  rm -f ${srcdir}/dest${_sysroot}/usr/lib/charset.alias
}

package() {
  mkdir -p "${pkgdir}${_sysroot}"
  cp -rf "${srcdir}/dest${_sysroot}/"* "${pkgdir}${_sysroot}/"

  [[ -n $(ls "${pkgdir}${_sysroot}"/usr/bin/*intl*.dll 2>/dev/null) ]] || {
    error "no libintl DLL was installed"
    return 1
  }
}
