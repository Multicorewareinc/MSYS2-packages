# Maintainer: Alexey Pavlov <alexpux@gmail.com>
#
# aarch64-pc-msys build of gettext (for libintl), staged into the cross
# sysroot.  Sources and all 18 patches are taken unchanged from the native
# gettext/ recipe; only the configure triplets and the install prefix differ.
#
# Packaged as one package rather than the native five-way split - the point
# here is to provide libintl to the rest of the aarch64 chain, not to mirror
# the repo's packaging granularity.

_target=aarch64-pc-msys
_sysroot=/usr/${_target}

pkgbase=gettext
pkgname=cross-msysarm64-gettext
pkgver=0.22.5
pkgrel=1
pkgdesc="GNU internationalization library (${_target})"
arch=('x86_64')
url="https://www.gnu.org/software/gettext/"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/gettext.git'
msys2_references=(
  "cpe: cpe:/a:gnu:gettext"
)
license=('spdx:GPL-3.0-or-later AND LGPL-2.1-or-later')
groups=('cross-msysarm64')
depends=('cross-msysarm64-libiconv' 'cross-msysarm64-runtime-devel')
makedepends=('cross-msysarm64-gcc' 'cross-msysarm64-binutils' 'autotools' 'groff')
options=(!docs '!strip' 'staticlibs' 'libtool')
source=(https://ftp.gnu.org/pub/gnu/gettext/${pkgbase}-${pkgver}.tar.gz{,.sig}
        gettext-tools-tests-locale-ll-es.patch
        gettext-0.21.1-autopoint-V.patch
        gettext-0.21.1-cygwin-ftm.patch
        gettext-0.22-no-woe32dll-gettext-tools-configure-ac.patch
        gettext-0.22-no-woe32dll-m4-woe32-dll-m4.patch
        gettext-0.22.5-gettext-runtime-gnulib-lib-localcharset-c.patch
        gettext-0.22.5-gettext-runtime-gnulib-lib-localename-h.patch
        gettext-0.22.5-gettext-runtime-gnulib-lib-localename-unsafe-c.patch
        gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localcharset-c.patch
        gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-h.patch
        gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-unsafe-c.patch
        gettext-0.22.5-gettext-tools-gnulib-lib-localcharset-c.patch
        gettext-0.22.5-gettext-tools-gnulib-lib-localename-h.patch
        gettext-0.22.5-gettext-tools-gnulib-lib-localename-unsafe-c.patch
        gettext-0.22-disable-libtextstyle.patch
        gettext-0.19.8.1-msys2.patch
        gettext-0.19.7-archive.patch)
