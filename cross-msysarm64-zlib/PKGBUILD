# Maintainer: Alexey Pavlov <Alexpux@gmail.com>
#
# aarch64-pc-msys build of zlib, staged into the cross sysroot.
# Sources and patches are taken unchanged from the native zlib/ recipe; only
# the toolchain prefix and the install prefix differ.

_target=aarch64-pc-msys
_sysroot=/usr/${_target}

pkgbase=zlib
pkgname=cross-msysarm64-zlib
pkgver=1.3.2
pkgrel=1
pkgdesc="Compression library implementing the deflate method (${_target})"
arch=('x86_64')
groups=('cross-msysarm64')
license=('spdx:Zlib')
url="https://www.zlib.net/"
msys2_repository_url="https://github.com/madler/zlib"
msys2_references=(
  "cpe: cpe:/a:gnu:zlib"
  "cpe: cpe:/a:zlib:zlib"
)
msys2_ignore_vulnerabilities=(
  "CVE-2026-22184" # only affects demo program untgz which we don't ship
)
depends=('cross-msysarm64-runtime-devel')
makedepends=('cross-msysarm64-gcc' 'cross-msysarm64-binutils')
options=('!strip' 'staticlibs')
source=("https://github.com/madler/zlib/releases/download/v${pkgver}/zlib-${pkgver}.tar.xz"{,.asc}
        zlib-1.2.13-configure.patch
        zlib-1.2.13-gzopen_w.patch)
sha256sums=('d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3'
            'SKIP'
            '43726a2170b298059391c0faec0c893aa7ca59b1201afd9f807c49d39ce25527'
            '3c5186940741cf380ab598362c564c792965e9d25906ef75087e9e7389becbc5')
validpgpkeys=('5ED46A6721D365587791E2AA783FCD8E58BCAFBA')

prepare() {
  cd ${srcdir}/${pkgbase}-${pkgver}

  patch -p2 -i ${srcdir}/zlib-1.2.13-configure.patch
  patch -p2 -i ${srcdir}/zlib-1.2.13-gzopen_w.patch
}

build() {
  cd ${srcdir}/${pkgbase}-${pkgver}

  # zlib has no usable autotools build - the native recipe says as much and
  # drives win32/Makefile.gcc instead, which takes the toolchain through a
  # PREFIX variable rather than --host.  So there is no triplet to set here;
  # PREFIX=aarch64-pc-msys- is what selects the cross compiler.
  #
  # -DZ_HAVE_UNISTD_H is needed because win32/Makefile.gcc assumes a Windows
  # build with no unistd.h; without it lseek/read/write are implicitly declared
  # and the compiler's C23 default turns that into an error.
  # Flags follow the tested standalone build script for this package.
  #
  # -specs=${_SPECS} is the important one: it supplies -e _msys_dll_entry for
  # shared links, which the packaged cross gcc gets wrong (its stock specs name
  # _cygwin_dll_entry, which nothing in this sysroot defines, so ld only warns
  # and emits a DLL with AddressOfEntryPoint 0 whose initialisation never runs).
  # ${_SPECS} is defined by the makepkg profile and points at the copy vendored
  # in crossarm64/.
  #
  # -DZ_HAVE_UNISTD_H because win32/Makefile.gcc assumes a Windows build with no
  # unistd.h; without it lseek/read/write are implicitly declared and the
  # compiler's C23 default turns that into an error.
  #
  # STRIP=: because win32/Makefile.gcc strips the DLL itself with the host
  # strip, which cannot read aarch64 objects - the same reason the profile sets
  # !strip and ncurses passes --disable-stripping.
  make -j1 -f win32/Makefile.gcc \
    PREFIX="${_target}-" \
    SHAREDLIB=msys-z.dll \
    STRIP=: \
    CFLAGS="-O2 -Wall -DZ_HAVE_UNISTD_H -specs=${_SPECS}" \
    LDFLAGS="-specs=${_SPECS} -Wl,--disable-high-entropy-va"

  make -f win32/Makefile.gcc install \
    DESTDIR="${srcdir}/dest" \
    SHAREDLIB=msys-z.dll \
    BINARY_PATH=${_sysroot}/usr/bin \
    INCLUDE_PATH=${_sysroot}/usr/include \
    LIBRARY_PATH=${_sysroot}/usr/lib \
    prefix=${_sysroot}/usr \
    SHARED_MODE=1 \
    PREFIX="${_target}-"

  install -D zlib.3 "${srcdir}/dest${_sysroot}/usr/share/man/man3/zlib.3"

  # A silent fallback to static-only is the expensive failure here: the build
  # succeeds and only a later consumer fails on undefined __imp_* symbols.
  [[ -f ${srcdir}/dest${_sysroot}/usr/bin/msys-z.dll ]] || {
    error "msys-z.dll was not produced"; return 1
  }
}

package() {
  mkdir -p "${pkgdir}${_sysroot}"
  cp -rf "${srcdir}/dest${_sysroot}/"* "${pkgdir}${_sysroot}/"

  install -D -m644 "${srcdir}/${pkgbase}-${pkgver}/LICENSE" \
    "${pkgdir}${_sysroot}/usr/share/licenses/${pkgname}/LICENSE"

  sed -e "s| -L\${sharedlibdir}||g" -i "${pkgdir}${_sysroot}/usr/lib/pkgconfig/zlib.pc"
}
