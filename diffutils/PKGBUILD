# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=diffutils
pkgver=3.12
pkgrel=1
pkgdesc="Utility programs used for creating patch files"
arch=('i686' 'x86_64' 'aarch64')
url="https://www.gnu.org/software/diffutils"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/diffutils.git'
msys2_references=(
  "anitya: 436"
  "cpe: cpe:2.3:a:gnu:diffutils"
)
license=('spdx:GPL-3.0-or-later')
depends=('sh' 'libiconv' 'libintl')
makedepends=('autotools' 'gcc' 'gettext-devel' 'libiconv-devel')
source=(https://mirrors.kernel.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.xz{,.sig})
sha256sums=('7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd'
            'SKIP')
validpgpkeys=('155D3FC500C834486D1EEA677FD9FCCB000BEEEE') # Jim Meyering <jim@meyering.net>

build() {
  cd ${srcdir}/${pkgname}-${pkgver}

  # make sure tests are running OK
  sed -i "s/mkdir -m 0700/mkdir /" tests/init.sh

  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    ./configure --build=${CHOST} \
      --host=aarch64-pc-cygwin \
      --prefix=/usr \
      --without-libiconv-prefix \
      --without-libintl-prefix \
      gl_cv_func_getopt_gnu=yes \
      gl_cv_func_working_mktime=yes \
      ac_cv_func_strcasecmp=yes \
      gl_cv_func_strcasecmp_works=no \
      ac_cv_header_stdbit_h=no
    make
    return
  fi

  ./configure \
    --build=${CHOST} \
    --prefix=/usr \
    --without-libiconv-prefix \
    --without-libintl-prefix
  make
}

check() {
  [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]] && return 0
  cd ${srcdir}/${pkgname}-${pkgver}
  make check || true
}

package() {
  cd ${srcdir}/${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
