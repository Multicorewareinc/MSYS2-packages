# Maintainer: Alexey Pavlov <alexpux@gmail.com>
# Contributor: Ray Donnelly <mingw.android@gmail.com>
#
# aarch64-pc-msys cross build of bash, staged into the cross sysroot.
# Sources and patches are taken unchanged from the native bash/ recipe -
# including the aarch64 IMP() fix carried in 0001-bash-4.4-cygwin.patch - and
# only the configure triplets and the install prefix differ.

_target=aarch64-pc-msys
_sysroot=/usr/${_target}

pkgbase=bash
pkgname=cross-msysarm64-bash
_basever=5.3
_patchlevel=015 #prepare for some patches
pkgver=${_basever}.${_patchlevel}
pkgrel=1
pkgdesc="The GNU Bourne Again shell (${_target})"
arch=('x86_64')
license=('spdx:GPL-3.0-or-later')
url="https://www.gnu.org/software/bash/bash.html"
msys2_repository_url="https://cgit.git.savannah.gnu.org/cgit/bash.git"
msys2_references=(
  "cpe: cpe:/a:gnu:bash"
)
validpgpkeys=('7C0135FB088AAF6C66C650B9BB5869F064EA74AB') # Chet Ramey
groups=('cross-msysarm64')
depends=('cross-msysarm64-readline' 'cross-msysarm64-ncurses'
         'cross-msysarm64-gettext' 'cross-msysarm64-libiconv'
         'cross-msysarm64-runtime-devel')
makedepends=('cross-msysarm64-gcc' 'cross-msysarm64-binutils' 'autotools')
options=('!strip' 'staticlibs')
source=(https://ftp.gnu.org/gnu/bash/bash-${_basever}.tar.gz{,.sig}
        0001-bash-4.4-cygwin.patch
        0002-bash-4.3-msysize.patch
        0005-bash-4.3-msys2-fix-lineendings.patch
        0006-bash-4.3-add-pwd-W-option.patch
        0007-fix-static-build.patch)
if [ $_patchlevel -gt 000 ]; then
  for (( p=1; p<=$((10#${_patchlevel})); p++ )); do
    source=(${source[@]} https://ftp.gnu.org/gnu/bash/bash-${_basever}-patches/bash${_basever//./}-$(printf "%03d" $p){,.sig})
  done
fi
noextract=(${pkgbase}-${_basever}.tar.gz)

prepare() {
  [[ -d ${pkgbase}-${_basever} ]] && rm -rf ${pkgbase}-${_basever}
  tar -xzvf ${srcdir}/${pkgbase}-${_basever}.tar.gz || true
  cd ${srcdir}/${pkgbase}-${_basever}

  for (( p=1; p<=$((10#${_patchlevel})); p++ )); do
    msg "applying patch bash${_basever//./}-$(printf "%03d" $p)"
    patch -p0 -i $srcdir/bash${_basever//./}-$(printf "%03d" $p)
  done

  patch -p1 -i ${srcdir}/0001-bash-4.4-cygwin.patch
  patch -p1 -i ${srcdir}/0002-bash-4.3-msysize.patch
  patch -p1 -i ${srcdir}/0005-bash-4.3-msys2-fix-lineendings.patch
  patch -p1 -i ${srcdir}/0006-bash-4.3-add-pwd-W-option.patch
  patch -p1 -i ${srcdir}/0007-fix-static-build.patch

  autoconf
}

build() {
  cd ${srcdir}/${pkgbase}-$_basever

  export MSYSTEM=CYGWIN

  # Configured as a *native* build for the target, not a cross build, and the
  # difference is not cosmetic.
  #
  # autoconf sets cross_compiling=yes purely because --host differs from
  # --build; it never tries to run anything ("checking whether we are cross
  # compiling... yes" with no conftest in config.log).  Every AC_RUN_IFELSE is
  # then skipped and answered by a guess.  bash leans on those heavily: with
  # --build=x86_64-pc-cygwin, configure warned that it could not check, and
  # guessed at, fifteen of them - WEXITSTATUS offset (guessed 0, actually 8),
  # strcoll, WCONTINUED, sys_siglist, pgrp synchronization, dup2, fnmatch,
  # opendir, printf, ulimit, getcwd and more.  Only one of those guesses broke
  # the build (getcwd -> GETCWD_BROKEN -> config-bot.h undefines HAVE_GETCWD ->
  # dcigettext.c falls back to a K&R "char *getwd ();" that conflicts with the
  # real declaration under the compiler's C23 default).  The rest would have
  # silently produced a shell with wrong exit statuses and degraded collation.
  #
  # This host is Windows-on-ARM: aarch64 binaries execute directly, which is
  # verified above by ncurses and readline test programs that were compiled and
  # then run.  So the honest description of this build is native-for-aarch64
  # using a prefixed toolchain, and saying so lets configure answer all fifteen
  # by actually running them.  CC/AR/... are exported by the makepkg profile, so
  # naming the target as the build system cannot make configure fall back to the
  # host's x86_64 gcc - it never looks for an unprefixed compiler.
  #
  # This is fail-fast rather than silent: if the target binaries could not run,
  # autoconf would stop at "cannot run C compiled programs".

  # The sysroot bin directories are APPENDED, never prepended: they are on PATH
  # only so that binaries compiled during configure can load msys-2.0.dll, and
  # PATH order does not affect that.  Prepending them shadows the host's tools
  # with target ones - once cross-msysarm64-sed is installed, a prepended
  # sysroot bin makes configure run the aarch64 sed instead of the host's, and
  # config.status then fails with "Something went wrong bootstrapping makefile
  # fragments for automatic dependency tracking".
  PATH="${PATH}:${_sysroot}/bin:${_sysroot}/usr/bin"
  export PATH

  # Linked against the real libintl and libiconv from the sysroot, rather than
  # bash's bundled lib/intl.  The native recipe passes --without-libintl-prefix
  # /--without-libiconv-prefix, which only tells gettext's m4 not to go hunting
  # in extra prefixes; here the libraries live in the sysroot the compiler
  # already searches, so name that prefix explicitly and let configure find
  # them.  Verified after the build by checking bash.exe's imports.
  #
  # bash_cv_* short-circuit probes that would otherwise need to run a test
  # program; the native recipe passes the same three.
  ./configure \
    --build=${_target} \
    --host=${_target} \
    --prefix=${_sysroot}/usr \
    --sysconfdir=${_sysroot}/etc \
    --localstatedir=${_sysroot}/var \
    --enable-static-link \
    --enable-readline \
    --enable-nls \
    --with-libintl-prefix=${_sysroot}/usr \
    --with-libiconv-prefix=${_sysroot}/usr \
    --with-installed-readline \
    --without-bash-malloc \
    --with-curses \
    bash_cv_dev_stdin=present \
    bash_cv_dev_fd=standard \
    bash_cv_termcap_lib=libncurses

  # Prepopulate the release level.
  expr ${pkgrel} > .build || :

  # TILDE_LIB=
  #     bash's configure only ever special-cases cygwin*, never msys*, so on an
  #     aarch64-pc-msys host it misses the case that sets TILDE_LIB empty and
  #     instead links its own lib/tilde.  With --with-installed-readline that
  #     collides with the copy already in libreadline, giving "multiple
  #     definition of `tilde_expand'".  Overriding on the make command line
  #     gets the cygwin behaviour without patching a generated configure - and
  #     it has to be the command line, since prepare() regenerates configure
  #     with autoconf.  Harmless if configure ever learns the msys case.
  #
  # The other three overrides are exactly what the native recipe passes.
  make CPPFLAGS=-DWORDEXP_OPTION \
       TILDE_LIB= \
       HISTORY_LDFLAGS= \
       READLINE_LDFLAGS= \
       LOCAL_LDFLAGS='-Wl,--export-all,--out-implib,lib$(@:.exe=.dll.a)'

  [[ -f bash.exe ]] || { error "bash.exe was not produced"; return 1; }

  # The point of depending on gettext is that bash uses the *installed*
  # libintl rather than its bundled lib/intl.  If configure fails to find the
  # external one it silently falls back to the bundle and still builds
  # successfully, so this has to be checked rather than assumed.
  #
  # The check is deliberately not "does bash.exe import an intl DLL": with
  # --enable-static-link it never will.  The native MSYS2 bash.exe imports only
  # msys-2.0.dll, KERNEL32 and USER32 while still containing gettext, because
  # libintl is linked in statically.  What distinguishes the two cases is
  # whether bash compiled its own copy: when the external library is used,
  # lib/intl is not built at all.
  if [[ -f lib/intl/libintl.a ]]; then
    error "bash built its bundled lib/intl - configure did not find the installed libintl"
    return 1
  fi
}

package() {
  cd ${srcdir}/${pkgbase}-$_basever
  make DESTDIR=${pkgdir} install

  # MSYS2 ships sh as a copy of bash.
  cp -fp ${pkgdir}${_sysroot}/usr/bin/{ba,}sh.exe

  cd ${pkgdir}${_sysroot}/usr/share/man/man1 > /dev/null
  echo '.so man1/bash.1' > sh.1
  echo '.so man1/bash_builtins.1.gz' > alias.1

  gzip alias.1
  for f in bg bind break builtin caller case cd command compgen complete \
    continue declare dirs disown do done elif else enable esac eval exec \
    exit export fc fg fi for function getopts hash help history if in jobs \
    let local logout popd pushd read readonly return select set shift shopt \
    source suspend then time times trap type typeset ulimit umask unalias \
    unset until wait while [ ; do
    cp -fp alias.1.gz $f.1.gz
  done
}

