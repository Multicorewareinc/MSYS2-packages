pkgbase=libgpg-error
pkgname=('libgpg-error' 'libgpg-error-devel') # 'gpg-error'
pkgver=1.61
pkgrel=2
pkgdesc="Support library for libgcrypt"
arch=('i686' 'x86_64' 'aarch64')
url="https://gnupg.org"
msys2_repository_url="https://git.gnupg.org/cgi-bin/gitweb.cgi?p=libgpg-error.git"
msys2_references=(
  "cpe: cpe:/a:gnupg:libgpg-error"
)
license=('spdx:LGPL-2.1-or-later')
depends=('sh' 'libiconv' 'libintl')
makedepends=('libiconv-devel' 'gettext-devel' 'autotools' 'gcc')
source=(https://gnupg.org/ftp/gcrypt/libgpg-error/${pkgname}-${pkgver}.tar.bz2{,.sig}
        gnulib-weak.patch
        gpg-error-static-linking.patch)
sha256sums=('7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93'
            'SKIP'
            '0df2f92ab866e9d9824086cca89ff286cfdfad5e659cb2b655061e0c7e562e3a'
            '9780e3e397b983ef52d5dae22d54c4453a47bddf04eafa2f874c75038e3485eb')
#These might be signed by any of these keys https://gnupg.org/signature_key.html
validpgpkeys=('5B80C5754298F0CB55D8ED6ABCEF7E294B092E28'
              '6DAA6E64A76D2840571B4902528897B826403ADA'
              'AC8E115BF73E2D8D47FA9908E98E9B2D19C6C8BD'
              '02F38DFF731FF97CB039A1DA549E695E905BA208')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  patch -p1 -i ${srcdir}/gnulib-weak.patch
  patch -p1 -i ${srcdir}/gpg-error-static-linking.patch

  # LOCAL WORKAROUND, not for upstream: on the ARM64 build machine,
  # Microsoft Defender's command-line detection (Trojan:Win32/Commando.A!ml)
  # refuses to start cc1 for src/posix-thread.c ("cannot execute cc1: spawn:
  # Permission denied"); the detection keys on the posix-thread file and
  # object names.  Compile the same file under another name.
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    mv src/posix-thread.c src/thread-posix.c
    sed -i 's/\bposix-thread\.c\b/thread-posix.c/' src/Makefile.am
  fi
  autoreconf -fi
}

build() {
  cd "${srcdir}"/${pkgname}-${pkgver}

  # aarch64-pc-cygwin cross: --host selects the cross compiler.
  # gpg-error.h embeds the lock object layout.  Natively it is generated by
  # running gen-posix-lock-obj; when cross-compiling mkheader takes it from
  # src/syscfg/lock-obj-pub.<os>.h, and there is none for Cygwin.  On Cygwin
  # pthread_mutex_t is a pointer and PTHREAD_MUTEX_INITIALIZER is the
  # constant 19 (x86_64 and aarch64 alike), so write what the generator
  # prints natively.
  local _xargs=(--build=${CHOST})
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _xargs+=(--host=aarch64-pc-cygwin)
    cat > src/syscfg/lock-obj-pub.cygwin.h <<'EOF'
## lock-obj-pub.aarch64-pc-cygwin.h
## File created by gen-posix-lock-obj - DO NOT EDIT
## To be included by mkheader into gpg-error.h

typedef struct
{
  long _vers;
  union {
    volatile char _priv[8];
    long _x_align;
    long *_xp_align;
  } u;
} gpgrt_lock_t;

#define GPGRT_LOCK_INITIALIZER {1,{{19,0,0,0,0,0,0,0}}}
EOF
  fi
  ./configure \
    --prefix=/usr \
    "${_xargs[@]}" \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --enable-install-gpg-error-config \
    --enable-shared \
    --enable-static

  make no_undefined=-no-undefined
  make DESTDIR="${srcdir}/dest" install
}

check() {
  cd ${srcdir}/${pkgname}-${pkgver}
  make check
}

package_libgpg-error() {
  groups=('libraries')

  mkdir -p ${pkgdir}/usr/share
  cp -rf ${srcdir}/dest/usr/bin ${pkgdir}/usr/
  rm -f ${pkgdir}/usr/bin/*-config
  cp -rf ${srcdir}/dest/usr/share/locale ${pkgdir}/usr/share/
}

package_libgpg-error-devel() {
  pkgdesc="libgpg-error headers and libraries"
  groups=('development')
  options=('staticlibs')
  depends=('libiconv-devel' 'gettext-devel')

  mkdir -p ${pkgdir}/usr/{bin,share}
  cp -f ${srcdir}/dest/usr/bin/*-config ${pkgdir}/usr/bin/
  cp -rf ${srcdir}/dest/usr/include ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/lib ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/share/aclocal ${pkgdir}/usr/share/
  cp -rf ${srcdir}/dest/usr/share/common-lisp ${pkgdir}/usr/share/
}
