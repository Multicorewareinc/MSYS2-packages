# Maintainer: Alexey Pavlov <alexpux@gmail.com>
#
# aarch64-pc-msys build of coreutils, staged into the cross sysroot.
# Sources and all four patches are taken unchanged from the native coreutils/
# recipe; only the configure triplets and the install prefix differ.
#
# This is also where hostname comes from: MSYS2 builds it here via
# --enable-install-program, not as a separate package.

_target=aarch64-pc-msys
_sysroot=/usr/${_target}

pkgbase=coreutils
pkgname=cross-msysarm64-coreutils
pkgver=8.32
pkgrel=5
pkgdesc="The basic file, shell and text manipulation utilities (${_target})"
arch=('x86_64')
license=('spdx:GPL-3.0-or-later')
url="https://www.gnu.org/software/coreutils"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/coreutils.git'
msys2_references=(
  "cpe: cpe:/a:gnu:coreutils"
)
groups=('cross-msysarm64')
depends=('cross-msysarm64-libiconv' 'cross-msysarm64-gettext'
         'cross-msysarm64-runtime-devel')
makedepends=('cross-msysarm64-gcc' 'cross-msysarm64-binutils' 'autotools')
options=('!strip')
source=(https://ftp.gnu.org/gnu/${pkgbase}/${pkgbase}-${pkgver}.tar.xz{,.sig}
        001-coreutils-8.30.patch
        002-coreutils-8.32-enable-stdbuf.patch
        003-coreutils-8.32-fix-test-cases.patch
        004-msystem-osname-cygwin.patch)
sha256sums=('4458d8de7849df44ccab15e16b1548b285224dbba5f08fac070c1c0e0bcc4cfa'
            'SKIP'
            '467bde24da0ccea48260f58d3c94a84de4e027ab598a926003642f791da47ca2'
            'e3be62b9aceb3231f09f05bc3bd8b18f6aaa495f5063781cdd261d560a7e80d0'
            'ad9e0582373500c0668e38483401169f48d6a2f8ad8d28ef8e7b06e4a3e08a74'
            '3922afd54b2323772f5cbd0638d0887ef858199bbaf4076a1db318173021c3dc')
validpgpkeys=('6C37DC12121A5006BC1DB804DF6FD971306037D9')

prepare() {
  cd ${srcdir}/${pkgbase}-${pkgver}

  patch -p1 -i ${srcdir}/001-coreutils-8.30.patch
  patch -p1 -i ${srcdir}/002-coreutils-8.32-enable-stdbuf.patch
  patch -p1 -i ${srcdir}/003-coreutils-8.32-fix-test-cases.patch

  # https://github.com/msys2/MSYS2-packages/issues/3012
  patch -p1 -i ${srcdir}/004-msystem-osname-cygwin.patch

  autoreconf -fi
}

build() {
  # Fail fast if makepkg was run without --config crossarm64/makepkg-crossarm64.conf.
  # Otherwise CC comes from /etc/makepkg.conf (=gcc) and the whole package builds as
  # native x86_64 while still claiming --host=aarch64-pc-msys.  See guard.sh.
  source "${startdir}/../crossarm64/guard.sh"
  crossarm64_assert_env

  [[ -d ${srcdir}/build-${_target} ]] && rm -rf ${srcdir}/build-${_target}
  mkdir -p ${srcdir}/build-${_target} && cd ${srcdir}/build-${_target}

  export gl_cv_have_weak=no

  # The sysroot bin directories are APPENDED, never prepended: they are on PATH
  # only so that binaries compiled during configure can load msys-2.0.dll, and
  # PATH order does not affect that.  Prepending them shadows the host's tools
  # with target ones - with cross-msysarm64-sed installed, a prepended sysroot
  # bin makes configure run the aarch64 sed instead of the host's, and
  # config.status then fails with "Something went wrong bootstrapping makefile
  # fragments for automatic dependency tracking".
  PATH="${PATH}:${_sysroot}/bin:${_sysroot}/usr/bin"
  export PATH

  # Native for the target rather than cross: autoconf skips every AC_RUN_IFELSE
  # the moment --host differs from --build and answers them with guesses.
  # coreutils vendors an enormous amount of gnulib and leans on those probes
  # more than anything else in this chain, so guessed answers would be
  # especially costly.  CC/AR/... come from the makepkg profile, so naming the
  # target as the build system cannot redirect tool lookup to the host's gcc.
  #
  # --without-gmp: coreutils uses GMP for arbitrary-precision arithmetic in
  # expr and factor.  There is no cross-msysarm64-gmp yet, so state this rather
  # than letting configure's probe decide from whatever happens to be
  # installed - the package's capabilities should not vary by accident.  expr
  # and factor still work, on long integers instead of bignums.  Drop this once
  # gmp is built for aarch64.
  #
  # The two gl_cv_func_strto*_works overrides are what the native recipe
  # passes.
  #
  # ac_cv_func_strtold=no is needed on top of them, and is not a workaround for
  # a bug - the target genuinely has no strtold.  On aarch64-pc-msys long
  # double is 8 bytes, the same as double (__SIZEOF_LONG_DOUBLE__=8, against 16
  # on x86_64), so newlib deliberately leaves _HAVE_LONG_DOUBLE undefined in
  # newlib.h and stdlib.h never declares strtold.
  #
  # configure still answers yes, because AC_CHECK_FUNC only link-tests and a
  # stray "T strtold" does exist in libc.a.  gnulib therefore skips its own
  # lib/strtold.c and c-strtod.c calls an undeclared function, which the
  # compiler's C23 default turns into an error:
  #     lib/c-strtod.c:34:17: error: implicit declaration of function 'strtold'
  # Declaring it absent makes gnulib supply the replacement, which on this
  # target is simply strtod - the correct behaviour when the two types are
  # identical.
  #
  # CFLAGS="-O2" - i.e. autoconf's default -g -O2 without the -g - works around
  # a compiler crash.  Compiling lib/mountlist.c dies with
  #     winscard.h:180:3: internal compiler error: Segmentation fault
  # pointing at a w32api header reached through windows.h.  The header is not
  # the problem: -O0, -O2 -fno-tree-ccp and -fno-var-tracking all compile the
  # file, and what those three have in common is dropping -g, so the crash is
  # in debug-info generation.  That makes it the same underlying fault as the
  # "during RTL pass: vartrack" ICE worked around in cross-msysarm64-gettext,
  # surfacing here during parsing rather than in a named pass.
  #
  # Nothing here needs debug info: the profile sets !strip only because the
  # host strip cannot read aarch64 objects.
  ../${pkgbase}-${pkgver}/configure \
    --build=${_target} \
    --host=${_target} \
    --prefix=${_sysroot}/usr \
    --libexecdir=${_sysroot}/usr/lib \
    --sysconfdir=${_sysroot}/etc \
    --localstatedir=${_sysroot}/var \
    --program-transform-name=s/kill/gkill/ \
    --without-libintl-prefix \
    --without-libiconv-prefix \
    --without-gmp \
    --enable-install-program=arch,hostname \
    --enable-no-install-program=uptime \
    gl_cv_func_strtod_works=yes \
    gl_cv_func_strtold_works=yes \
    ac_cv_func_strtold=no \
    CFLAGS="-O2"

  # man1_MANS= skips man page generation.  coreutils builds each page by
  # symlinking the freshly built program into a temp directory and running
  # help2man on the symlink; here that dies with
  #     make[2]: *** [Makefile:17650: man/chroot.1] Error 139
  # i.e. SIGSEGV.  The programs themselves are fine - "chroot.exe --help" run
  # directly exits 0 - so it is the symlink-and-help2man step that breaks, not
  # the build.  The native x86_64 recipe does generate these, because there the
  # binaries being run are host-native.
  #
  # Consequence: this package ships no man pages.  Worth revisiting if they are
  # wanted; --help works on every program regardless.
  make man1_MANS=
}

package() {
  cd ${srcdir}/build-${_target}

  # INSTALL is overridden to the host's install.  Because this is configured as
  # a native build, coreutils sets INSTALL = $(cu_install_program) -c and
  # installs itself with the ginstall it has just built - which is an aarch64
  # binary, so this only works at all on a Windows-on-ARM host, and here it does
  # not work even there:
  #     src/ginstall -c src/ginstall.exe '.../usr/bin'
  #     /bin/sh: line 24: src/ginstall: Permission denied
  # The binary is present and marked executable, and every other coreutils
  # program built alongside it runs fine (ls, cat, echo and hostname all report
  # "(GNU coreutils) 8.32"), so this looks like the host refusing to execute
  # something named "install" rather than anything wrong with the build.
  #
  # A staged package build has no business installing with the target's own
  # tools regardless, so use the host's install and sidestep it.
  make DESTDIR=${pkgdir} INSTALL='/usr/bin/install -c' man1_MANS= install

  test ! -f ${pkgdir}${_sysroot}/usr/lib/coreutils/libstdbuf.so.exe ||
  mv ${pkgdir}${_sysroot}/usr/lib/coreutils/libstdbuf.so.exe \
    ${pkgdir}${_sysroot}/usr/lib/coreutils/libstdbuf.dll

  install -Dm644 ${srcdir}/${pkgbase}-${pkgver}/src/dircolors.hin \
    ${pkgdir}${_sysroot}/etc/DIR_COLORS

  # share/info/dir is the info index, rebuilt by install-info at install time
  # and owned by no package; shipping it collides with every other package that
  # installs info pages.
  rm -f ${pkgdir}${_sysroot}/usr/share/info/dir

  # hostname is the reason this package matters beyond coreutils itself.
  for _p in ls cp mv rm cat hostname; do
    [[ -f ${pkgdir}${_sysroot}/usr/bin/${_p}.exe ]] || {
      error "${_p}.exe was not produced"; return 1
    }
  done
}
