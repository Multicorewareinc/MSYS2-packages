# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Net-SSLeay'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.96
pkgrel=3
pkgdesc="Perl extension for using OpenSSL"
arch=('i686' 'x86_64' 'aarch64')
license=('spdx:Artistic-2.0')
url="https://metacpan.org/dist/Net-SSLeay/"
msys2_references=(
  'purl: pkg:cpan/CHRISN/Net-SSLeay'
)
groups=('perl-modules')
makedepends=('openssl-devel' 'perl-devel' 'make' 'gcc')
depends=('openssl')
provides=("perl-Net-SSLeay=${pkgver}")
conflicts=('perl-Net-SSLeay')
replaces=('perl-Net-SSLeay')
options=(!emptydirs)
source=("https://cpan.metacpan.org/authors/id/C/CH/CHRISN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('ab213691685fb2a576c669cbc8d9266f8165a31563ad15b7c4030b94adfc0753')

prepare() {
  cd ${srcdir}/${_perlname}-${pkgver}
}

build() {
  cd ${srcdir}/${_perlname}-${pkgver}

  export OPTIMIZE="$CFLAGS"
  export OPENSSL_PREFIX=/usr

  # aarch64-pc-cygwin cross: Makefile.PL runs under the target's perl (it
  # runs natively on the ARM64 build machine), so MakeMaker takes the
  # target's %Config and runs the target's openssl; the cross compiler
  # builds against the sysroot's perl and OpenSSL, through a prefix both
  # runtimes resolve.
  local _perl=perl _mmargs=()
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    local _s=/usr/aarch64-pc-cygwin
    _perl=${_s}/usr/bin/perl.exe
    export OPENSSL_PREFIX=${_s}/usr
    _mmargs=(CC=aarch64-pc-cygwin-gcc LD=aarch64-pc-cygwin-gcc
             PERL_INC=${_s}/usr/lib/perl5/core_perl/CORE
             PERL_ARCHLIB=${_s}/usr/lib/perl5/core_perl
             PERL=${_perl} FULLPERL=${_perl})
  fi

  # install module in vendor directories.
  PERL_MM_USE_DEFAULT=1 ${_perl} Makefile.PL -- INSTALLDIRS=vendor "${_mmargs[@]}"
  make
}

package() {
  cd ${srcdir}/${_perlname}-${pkgver}

  # (the cross arm's install runs on the ARM64 runtime: hand it a path both
  # runtimes resolve)
  local _dest=${pkgdir}
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _dest=$(cygpath -m "${_dest}")
  fi
  make install DESTDIR="${_dest}"
  install -D -m644 README "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
