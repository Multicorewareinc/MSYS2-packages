# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=dash
pkgver=0.5.13.4
pkgrel=1
pkgdesc="A POSIX compliant shell that aims to be as small as possible"
arch=('i686' 'x86_64' 'aarch64')
url="http://gondor.apana.org.au/~herbert/dash/"
msys2_repository_url="https://git.kernel.org/pub/scm/utils/dash/dash.git"
msys2_references=(
  "cpe: cpe:/a:dash:dash"
  "gentoo: app-shells/dash"
)
license=('spdx:BSD-3-Clause AND GPL-2.0-or-later')
depends=('grep' 'sed' 'filesystem')
makedepends=('autotools' 'gcc')
install=dash.install
source=("http://gondor.apana.org.au/~herbert/dash/files/${pkgname}-${pkgver}.tar.gz")
sha256sums=('d10dfd41cda59165560db39ca915c2c4a7636fff04281d8d2df77ad92c753e2b')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # aarch64-pc-cygwin cross: the generators (mkinit, mksyntax, ...) run
  # during the build, so they are compiled by the build compiler.  -O1: at
  # -O2 the cross GCC emits SEH unwind offsets its assembler rejects
  # ("offset should be a multiple of 8", issue #38).
  local _xargs=() _opt=-O2
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _xargs+=(--build=${CHOST} --host=aarch64-pc-cygwin CC_FOR_BUILD=gcc)
    _opt=-O1
  fi
  ./configure --prefix=/usr \
      --bindir=/usr/bin \
      --mandir=/usr/share/man \
      --exec-prefix="" \
      "${_xargs[@]}" \
      CFLAGS="${_opt} -static-libgcc"
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install

  # license
  install -m644 -D COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING

  ln -s ${pkgdir}/usr/bin/{d,}ash.exe
  ln -s ${pkgdir}/usr/share/man/man1/{d,}ash.1
}
