# Maintainer: Windows on ARM Experiments

_realname=msys2-runtime
pkgbase=${_realname}
pkgname=cross-msysarm64-runtime
pkgver=3.6.7
pkgrel=14
pkgdesc="Cygwin POSIX emulation engine for aarch64-pc-cygwin"
arch=('x86_64')
options=('!strip' '!buildflags')
url="https://cygwin.com"
license=('GPL')
makedepends=(
  "cross-msysarm64-gcc"               # full stage-2 gcc (provides aarch64-pc-cygwin-gcc, libgcc.a, crtbegin/end.o, libstdc++); stage1 is removed/superseded
  "cross-msysarm64-binutils"          # provides: aarch64-pc-cygwin-ld, ar, etc.
  "cross-msysarm64-w32api-headers"    # provides: sysroot/include/w32api/*.h
  "cross-msysarm64-runtime-devel"     # provides: sysroot/include/ (newlib + cygwin headers)
  "mingw-w64-cross-mingwarm64-gcc"    # provides: aarch64-w64-mingw32-g++ for mingw helper
  "mingw-w64-cross-mingwarm64-crt"    # provides: /opt/aarch64-w64-mingw32/lib/
  "mingw-w64-cross-mingwarm64-zlib"   # provides: /opt/aarch64-w64-mingw32/lib/libz.a
  "cocom"                             # provides: osfmk tool for mach interface generation
  "git"
  "autotools"
)
source=(
  "${_realname}::git+https://github.com/Multicorewareinc/msys2-runtime#branch=runtime-upstream-9-sep-nomsys"
)
sha256sums=('SKIP')

_target=aarch64-pc-cygwin
_build=x86_64-pc-msys

prepare() {
  # -------------------------------------------------------------------------
  # BOOTSTRAP STUBS
  # We only stub things that ARE what we're building (circular deps).
  # Everything else must come from real dependency packages.
  #
  # Compare with Cygwin's build-cygwin.sh stage1:
  #   - Headers already installed by install-cygwin-headers.sh
  #   - Win32 libs already installed by build-mingw-crt.sh --enable-w32api
  #   - GCC stage1 already built → libgcc.a, crtbegin/end.o available
  #   - Only crt0.o and libcygwin.a are stubbed (they ARE the build output)
  # -------------------------------------------------------------------------

  # --- Real: libgcc.a ---
  # From cross-msysarm64-gcc-stage1. Copy to sysroot/lib for linker discovery.
  # Resolve the real path from the compiler (version-proof; -print-libgcc-file-name
  # IS the absolute path to libgcc.a) -- never hardcode the gcc version dir.
  cp "$(aarch64-pc-cygwin-gcc -print-libgcc-file-name)" \
    /usr/aarch64-pc-cygwin/lib/libgcc.a
  echo "libgcc.a from gcc-stage1 installed"

  # --- Stub: default-manifest.o ---
  # The linker auto-includes default-manifest.o for PE manifests; it's not part
  # of the dll itself. The full toolchain build's stage-1 runtime
  # (msys2-runtime-aarch64/PKGBUILD) creates this empty stub in the MSYS sysroot
  # /usr/aarch64-pc-cygwin/lib/. build-test runs only stage-2, so create it here
  # too — else the winsup/cygserver link fails "cannot find default-manifest.o".
  # (crt0.o is NOT stubbed here: the cross-msysarm64-runtime release ships the
  # real one, and apply-crt0-fix re-stages it after the build.) Idempotent.
  if [ ! -f /usr/aarch64-pc-cygwin/lib/default-manifest.o ]; then
    echo "" > /tmp/dm_empty.c
    aarch64-pc-cygwin-gcc -c /tmp/dm_empty.c -o /usr/aarch64-pc-cygwin/lib/default-manifest.o
    echo "default-manifest.o stub installed"
  fi

  # devices.cc: the old #pragma GCC optimize("O0") hack was removed (issue #5).
  # At the build's -O1 it compiles cleanly (the ldp_fusion SIGSEGV is -O2-only);
  # the per-object make rule below adds -mno-early-ldp-fusion so it also stays
  # safe if the tree is ever moved to -O2.

  # mkdir -p ${srcdir}/${_realname}/winsup/cygwin/aarch64
  # cp ${startdir}/winsup/cygwin/aarch64/fastcwd.cc \
  #    ${srcdir}/${_realname}/winsup/cygwin/aarch64/fastcwd.cc
  # echo "aarch64/fastcwd.cc injected from startdir"

  # --- Real: Win32 import libs ---
  # These now come from the cross-msysarm64-w32api-runtime PACKAGE, which installs
  # libkernel32/user32/advapi32/shell32/ntdll.a directly into the MSYS cross sysroot
  # /usr/aarch64-pc-cygwin/lib/ (see issue #3). The winsup link expects them there, so
  # a package-based build finds them already present and does NO /opt copy.
  # LEGACY FALLBACK: if the w32api-runtime package is not installed (e.g. a partial
  # build), fall back to copying from the mingw sysroot /opt/aarch64-w64-mingw32/lib/
  # (installed by mingw-w64-cross-mingwarm64-crt) — with a WARNING so it is obvious the
  # build is not yet on the packaged path. Idempotent either way.
  # netapi32/userenv/psapi/dbghelp are needed by the cygwin-linked utils
  # (--enable-utils, epic #36 Part B): mkpasswd/mkgroup -lnetapi32, cygpath/newgrp
  # -luserenv, ldd/pldd/ps -lpsapi, minidumper -ldbghelp. kernel32..ntdll are the
  # base set the DLL build needs. All present in /opt/aarch64-w64-mingw32/lib.
  echo "--- Ensuring Win32 import libs are in /usr/aarch64-pc-cygwin/lib ---"
  _ok=1
  for lib in kernel32 user32 advapi32 shell32 ntdll netapi32 userenv psapi dbghelp; do
    if [ -f /usr/aarch64-pc-cygwin/lib/lib${lib}.a ]; then
      echo "  lib${lib}.a present in cross sysroot (from cross-msysarm64-w32api-runtime)"
    elif [ -f /opt/aarch64-w64-mingw32/lib/lib${lib}.a ]; then
      cp -f /opt/aarch64-w64-mingw32/lib/lib${lib}.a /usr/aarch64-pc-cygwin/lib/
      echo "  WARNING: lib${lib}.a copied from /opt (legacy fallback) — install cross-msysarm64-w32api-runtime to use the packaged path"
    else
      echo "  ERROR: lib${lib}.a not in /usr/aarch64-pc-cygwin/lib NOR /opt/aarch64-w64-mingw32/lib — install cross-msysarm64-w32api-runtime (or mingw-w64-cross-mingwarm64-crt)"
      _ok=0
    fi
  done
  if [ $_ok -ne 1 ]; then
    echo "FATAL: Missing Win32 import libs. Install cross-msysarm64-w32api-runtime first."
    exit 1
  fi

  # --- libstdc++ header shadow removal ---
  # libstdc++ wrappers for C headers shadow newlib headers in the sysroot.
  # Remove them so winsup sees newlib's versions, not glibc-oriented wrappers.
  for f in fenv.h stdlib.h alloca.h unistd.h; do
    _wrapper="/usr/lib/gcc/aarch64-pc-cygwin/15.0.1/include/c++/${f}"
    if [ -f "${_wrapper}" ] && [ ! -f "${_wrapper}.bak" ]; then
      mv "${_wrapper}" "${_wrapper}.bak"
      echo "Moved shadowing header: ${f}"
    fi
  done

  # --- Headers: newlib + cygwin ---
  # These should already be in sysroot from cross-msysarm64-runtime-devel.
  # Refresh them from source to ensure they're the aarch64-patched versions.
  echo "--- Installing headers from source ---"

  # newlib first (base layer)
  # cp -rf ${srcdir}/${_realname}/newlib/libc/include/. \
  #   /usr/aarch64-pc-cygwin/sys-include/
  cp -rf ${srcdir}/${_realname}/newlib/libc/include/. \
    /usr/aarch64-pc-cygwin/include/

  # cygwin headers second (override layer)
  # cp -rf ${srcdir}/${_realname}/winsup/cygwin/include/. \
  #   /usr/aarch64-pc-cygwin/sys-include/
  cp -rf ${srcdir}/${_realname}/winsup/cygwin/include/. \
    /usr/aarch64-pc-cygwin/include/

  # (w32api/ mirror no longer needed: cross-msysarm64-w32api-headers now installs
  # the Win32 headers under include/w32api/ via --enable-w32api, so winsup's
  # <w32api/ntstatus.h> resolves directly.)
  echo "--- Header patch verification ---"
  grep -c "__aarch64__" \
    /usr/aarch64-pc-cygwin/sys-include/cygwin/signal.h && \
    echo "signal.h aarch64 patch OK" || \
    echo "ERROR: signal.h missing aarch64 — check mcw/aarch64-winsup-sync branch"

  grep -c "aarch64" \
    ${srcdir}/${_realname}/winsup/cygwin/local_includes/register.h && \
    echo "register.h aarch64 patch OK" || \
    echo "ERROR: register.h missing aarch64 — check source branch"

  # --- Run autogen from TOP-LEVEL ---

  cd ${srcdir}/${_realname}/winsup
  ./autogen.sh || autoreconf -fvi || true
}

build() {
  unset CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
  export CONFIG_SITE=/dev/null
  export CCACHE_DISABLE=1

  export PATH="/opt/bin:/usr/local/bin:/usr/bin:/bin"

  export CC=aarch64-pc-cygwin-gcc
  export CXX=aarch64-pc-cygwin-g++
  export AS=aarch64-pc-cygwin-as
  export LD=aarch64-pc-cygwin-ld
  export AR=aarch64-pc-cygwin-ar
  export RANLIB=aarch64-pc-cygwin-ranlib
  export STRIP=aarch64-pc-cygwin-strip
  export OBJCOPY=aarch64-pc-cygwin-objcopy
  export OBJDUMP=aarch64-pc-cygwin-objdump
  export NM=aarch64-pc-cygwin-nm
  export DLLTOOL=aarch64-pc-cygwin-dlltool
  export WINDRES=aarch64-pc-cygwin-windres
  export WINDMC=aarch64-pc-cygwin-windmc
  #  _headers="${HOME}/headers"
  which aarch64-w64-mingw32-g++ || \
    echo "WARNING: mingw aarch64 g++ not found"

  # Run autogen specifically for winsup
  cd ${srcdir}/${_realname}/winsup
  ./autogen.sh || autoreconf -fvi || true

  mkdir -p ${srcdir}/runtime-build
  cd ${srcdir}/runtime-build
  # Derive the gcc private dir from the compiler -- never hardcode the version.
  # A wrong version dir (e.g. "15" vs the installed "15.0.1") makes the -nostdinc
  # -isystem path dead, so gcc finds no <stddef.h> and newlib/winsup headers fall
  # through to the mingw sysroot copies -> "#error Only Win32 target is supported!".
  GCC_BASE="$(dirname "$(aarch64-pc-cygwin-gcc -print-libgcc-file-name)")"
  [ -f "${GCC_BASE}/include/stddef.h" ] || {
    echo "FATAL: gcc include dir not found under ${GCC_BASE}/include (no stddef.h)"
    echo "       -print-libgcc-file-name = $(aarch64-pc-cygwin-gcc -print-libgcc-file-name)"
    exit 1
  }
  echo "GCC_BASE resolved to ${GCC_BASE} (stddef.h present)"
  export CFLAGS="\
  -ffile-prefix-map=${srcdir}=. \
  -nostdinc \
  -D_MB_CAPABLE=1 \
  -isystem ${GCC_BASE}/include \
  -isystem ${GCC_BASE}/include-fixed \
  -isystem ${HOME}/headers/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include/w32api \
  -O1 -pipe"

  export CXXFLAGS="\
  -ffile-prefix-map=${srcdir}=. \
  -nostdinc \
  -nostdinc++ \
  -D_MB_CAPABLE=1 \
  -isystem ${GCC_BASE}/include \
  -isystem ${GCC_BASE}/include-fixed \
  -isystem ${GCC_BASE}/include/c++ \
  -isystem ${GCC_BASE}/include/c++/aarch64-pc-cygwin \
  -isystem ${GCC_BASE}/include/c++/backward \
  -isystem ${HOME}/headers/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include/w32api \
  -O1 -pipe"
  export ac_cv_lib_sframe_sframe_decode=no
  export ac_cv_lib_zstd_ZSTD_isError=no
  CXXFLAGS_FOR_TARGET="-Wno-error -Wno-narrowing" \
  ${srcdir}/${_realname}/winsup/configure \
    --prefix=/usr \
    --build=${_build} \
    --host=${_target} \
    --target=${_target} \
    --with-cross-bootstrap \
    --disable-doc \
    --enable-cygserver \
    --disable-dumper \
    --enable-utils \
    --without-mingw-progs \
    --enable-mingw-utils \
    CC="${CC}" \
    CXX="${CXX}" \
    AR="${AR}" \
    RANLIB="${RANLIB}" \
    NM="${NM}" \
    OBJCOPY="${OBJCOPY}" \
    OBJDUMP="${OBJDUMP}" \
    DLLTOOL="${DLLTOOL}" \
    WINDRES="${WINDRES}" \
    AS="${AS}" \
    LD="${LD}" \
    MINGW_CXX=aarch64-w64-mingw32-g++ \
    MINGW_CC=aarch64-w64-mingw32-gcc \
    CFLAGS="${CFLAGS}" \
    CXXFLAGS="${CXXFLAGS}"

sed -i '/config\.status.*--recheck/d' Makefile
sed -i 's/^am--refresh:.*/am--refresh:/' Makefile
# ADD THESE for subdirs too:
sed -i '/config\.status.*--recheck/d' cygwin/Makefile
sed -i 's/^am--refresh:.*/am--refresh:/' cygwin/Makefile
sed -i '/config\.status.*--recheck/d' cygserver/Makefile
sed -i 's/^am--refresh:.*/am--refresh:/' cygserver/Makefile

sed -i '/-mno-use-libstdc-wrappers/d' cygwin/Makefile
cat >> cygwin/Makefile << 'EOF'

# GCC-15 AArch64 per-file workarounds — keep the build's -O1; NO -O0 drops.
# Root causes (bisected on the pkgrel-2 cross toolchain, 2026-07-12):
#  devices.o           : SIGSEGV in RTL pass ldp_fusion at -O2 (harmless no-op at -O1)
#                        -> -mno-early-ldp-fusion
#  fhandler/netdrive.o : GCC-15 -Wmisleading-indentation whole-file scan hangs forever
#                        (optimizer is fine) -> -Wno-misleading-indentation (keeps -O1 -Wall -Werror)
#  libc/minires-os-if.o: GCC-15 cc1 INTEGRATED-preprocessor segfault on the deep macro-dense
#                        <iphlpapi.h> -> ole2.h -> rpcndr.h header chain (issue #79 / toolchain #7).
#                        Bisected 2026-07-27: the same TU compiles clean when preprocessed to a .i
#                        and fed with -fpreprocessed, and clean with a SEPARATE cpp pass, so the bug
#                        is in cc1's lex-while-parse path, NOT the optimizer (crashes at -O0 too),
#                        GC, --enable-checking, or stack size. Fix = run a separate cpp pass for this
#                        one C TU. Restores the Windows DNS resolver backend on AArch64.
devices.o: CXXFLAGS += -mno-early-ldp-fusion
fhandler/netdrive.o: CXXFLAGS += -Wno-misleading-indentation
libc/minires-os-if.o: CFLAGS += -no-integrated-cpp
EOF
cd cygwin
make child_info_magic.h shared_info_magic.h globals.h localtime.patched.c stamp-h1 config.h
cd ../
cd cygserver  
make -j$(nproc) OBJEXT=o
cd ../
sed -i '/^\$(LIBSERVER):/,/libcygserver\.a/c\
LIBSERVER = '"${srcdir}"'/runtime-build/cygserver/libcygserver.a
' cygwin/Makefile
sed -i '/-mno-use-libstdc-wrappers/d' cygwin/Makefile
cd cygwin 
# aarch64-pc-cygwin-g++ \
# -DHAVE_CONFIG_H \
# -I. \
# -I${srcdir}/${_realname}/winsup/cygwin \
# -U_FORTIFY_SOURCE \
# -I${srcdir}/${_realname}/winsup/cygwin/local_includes \
# -I${HOME}/MSYS2-packages/msys2-runtime-aarch64-stage-2/src/winsup/cygwin \
# -isystem ${srcdir}/${_realname}/winsup/cygwin/include \
# -isystem ${HOME}/MSYS2-packages/msys2-runtime-aarch64-stage-2/src/newlib/targ-include \
# -isystem ${srcdir}/${_realname}/newlib/libc/include \
# -fno-rtti -fno-exceptions -fno-use-cxa-atexit \
# -fno-threadsafe-statics \
# -nostdinc -nostdinc++ \
# -D_MB_CAPABLE=1 \
# -isystem /usr/lib/gcc/aarch64-pc-cygwin/15/include \
# -isystem /usr/lib/gcc/aarch64-pc-cygwin/15/include-fixed \
# -isystem /usr/lib/gcc/aarch64-pc-cygwin/15/include/c++ \
# -isystem /usr/lib/gcc/aarch64-pc-cygwin/15/include/c++/backward \
# -isystem ${HOME}/headers/aarch64-pc-cygwin/include \
# -isystem /usr/aarch64-pc-cygwin/include \
# -fno-merge-constants \
# -O0 \
# -MT fhandler/netdrive.o -MD -MP -MF /tmp/netdrive.Tpo \
# -c -o fhandler/netdrive.o \
# ${srcdir}/${_realname}/winsup/cygwin/fhandler/netdrive.cc

# touch fhandler/netdrive.o
# touch fhandler/.deps/netdrive.Po

aarch64-pc-cygwin-g++ -DHAVE_CONFIG_H \
-I. \
-I${srcdir}/${_realname}/winsup/cygwin \
-U_FORTIFY_SOURCE \
-I${srcdir}/${_realname}/winsup/cygwin/local_includes \
-I${srcdir}/winsup/cygwin \
-isystem ${srcdir}/${_realname}/winsup/cygwin/include \
-isystem ${srcdir}/newlib/targ-include \
-isystem ${srcdir}/${_realname}/newlib/libc/include \
-fno-rtti -fno-exceptions -fno-use-cxa-atexit \
-fno-threadsafe-statics \
-nostdinc -nostdinc++ \
-D_MB_CAPABLE=1 \
-isystem ${GCC_BASE}/include \
-isystem ${GCC_BASE}/include-fixed \
-isystem ${GCC_BASE}/include/c++ \
-isystem ${GCC_BASE}/include/c++/aarch64-pc-cygwin \
-isystem ${GCC_BASE}/include/c++/backward \
-isystem ${HOME}/headers/aarch64-pc-cygwin/include \
-isystem /usr/aarch64-pc-cygwin/include \
-isystem /usr/aarch64-pc-cygwin/include/w32api \
-fno-merge-constants \
-O1 -Wno-misleading-indentation \
-MT msys2_path_conv.o -MD -MP -MF /tmp/msys2_path_conv.Tpo \
-c -o msys2_path_conv.o \
${srcdir}/${_realname}/winsup/cygwin/msys2_path_conv.cc

touch msys2_path_conv.o

  cat > mb_check.c << 'EOF'
#ifndef _MB_CAPABLE
#error "_MB_CAPABLE is NOT defined"
#endif
int main() { return 0; }
EOF

  ${CC} ${CFLAGS} -c mb_check.c -o mb_check.o || {
    echo "MB_CAPABLE check failed"
    exit 1
  }

  echo "Current directory: $(pwd)"
  MAKEFILE="cygwin/Makefile"

  echo "Makefile clean patch applied"
# AR override bounds libdll.a archiving at 15 min (silent 3h15m stall at CCAS sigfe.o).
# ${startdir}, not ${srcdir}: makepkg -e stages no plain-file sources — hence not in source=().
  _arwd="${startdir}/ar-watchdog.sh"
  [ -f "${_arwd}" ] || { echo "FATAL: ar-watchdog.sh missing at ${_arwd}" >&2; exit 1; }
  make -j$(nproc) OBJEXT=o AR="bash ${_arwd} ${AR}"

  # --- native ARM64 MinGW host tools -------------------------------------------
  # --enable-mingw-utils builds only utils/mingw/ (cygwin-console-helper, ldh,
  # getprocaddrarm64) via the same automake path as native x86_64; the ~26
  # cygwin-linked utils stay off (--disable-utils).
  #
  # utils/ now has two toolchains, so invoke make separately per group:
  #
  # (a) MinGW host tools, built with aarch64-w64-mingw32-g++. CFLAGS/CXXFLAGS/
  #     CPPFLAGS are EMPTIED: build() sets -isystem /usr/aarch64-pc-cygwin/include
  #     for the cygwin DLL, which makes <windows.h> resolve to the MSYS sysroot and
  #     breaks the C++ compile (_GLIBCXX_NORETURN / 'exit' not declared). Emptying
  #     lets MinGW use its own /opt/aarch64-w64-mingw32 headers; AM_CXXFLAGS comes
  #     from the mingw Makefile.am.
  ( cd "${srcdir}/runtime-build/utils/mingw" && make CFLAGS= CXXFLAGS= CPPFLAGS= ) \
    || { echo "FATAL: 'make' in runtime-build/utils/mingw failed (MinGW host tools). Aborting."; exit 1; }

  # (b) cygwin-linked utils, native aarch64-pc-cygwin-g++ + msys sysroot flags. Stage real
  #     libmsys-2.0.a and Win32 import libs here (prepare() is skipped on reused srcdir).
  for _l in kernel32 user32 advapi32 shell32 ntdll netapi32 userenv psapi dbghelp; do
    if [ ! -f /usr/aarch64-pc-cygwin/lib/lib${_l}.a ] && [ -f /opt/aarch64-w64-mingw32/lib/lib${_l}.a ]; then
      cp -f /opt/aarch64-w64-mingw32/lib/lib${_l}.a /usr/aarch64-pc-cygwin/lib/
      echo "staged lib${_l}.a into sysroot for the util link (build() fallback; prepare() was skipped on srcdir reuse)"
    fi
  done
  _implib="$(find "${srcdir}/runtime-build/cygwin" -maxdepth 1 -name libmsys-2.0.a 2>/dev/null | head -1)"
  if [ -n "${_implib}" ]; then
    install -m644 "${_implib}" /usr/aarch64-pc-cygwin/lib/libmsys-2.0.a
    ln -sf libmsys-2.0.a /usr/aarch64-pc-cygwin/lib/libcygwin.a
    echo "staged real libmsys-2.0.a + libcygwin.a alias into sysroot for -lcygwin"
  else
    echo "::warning:: libmsys-2.0.a not found in runtime-build/cygwin — cygwin-linked utils may fail to link -lcygwin"
  fi
  # GCC-15 aarch64 cc1 hangs preprocessing the deep Windows header chain, so build utils with
  # -no-integrated-cpp (on $(CC)/$(CXX), not CFLAGS) plus -C to keep /*FALLTHRU*/ markers.
  ( cd "${srcdir}/runtime-build/utils" && make -k SUBDIRS= \
      CC="aarch64-pc-cygwin-gcc -no-integrated-cpp -C" \
      CXX="aarch64-pc-cygwin-g++ -no-integrated-cpp -C" ) \
    || echo "WARNING: some cygwin-linked utils did not build (-k continued); CI smoke gate reports per-util status."
}

package() {
  # Cross runtime package for the aarch64-pc-cygwin toolchain. Ships the real
  # crt0.o (`bl msys_crt0` — the bootstrap stub `nop;ret` causes the startup
  # hang), the runtime import lib, the native ARM64 msys-2.0.dll, and the newlib
  # libs INTO THE SYSROOT (/usr/aarch64-pc-cygwin/...). Explicit copies, not `make
  # DESTDIR install`, which targets /usr and would clobber the host x86_64 runtime.
  #
  # STRICT GUARANTEE: every artifact below is mandatory. A missing
  # file — or a crt0.o that is still the bootstrap STUB — is a HARD `exit 1`,
  # never a warning. This is what lets us retire apply-crt0-fix.sh: the package
  # cannot silently ship the stub that makes every exe hang at startup.
  pkgdesc="aarch64-pc-cygwin runtime: crt0 + libmsys-2.0 import lib + msys-2.0.dll + newlib libs (sysroot)"
  # NB: no depends=() on cross-msysarm64-newlib — build-msys.sh runs `makepkg -e`
  # without --nodeps, and the newlib pkg isn't pacman-installed during the build;
  # the two are independent file sets and the consumer pacman -U's both.
  local _rb="${srcdir}/runtime-build"

  install -d "${pkgdir}/usr/aarch64-pc-cygwin/lib"
  local _o _s

  # --- crt0.o / gcrt0.o: real ones only, stub rejected ---------------------
  # The whole startup-hang bug class lives here. Each startup object is verified
  # against the symbol it MUST define/reference, so a bootstrap stub (whose
  # mainCRTStartup is `nop; ret` and references nothing) is rejected:
  #   crt0.o   — the plain startup: mainCRTStartup calls msys_crt0, so the object
  #              carries an UNDEFINED `msys_crt0` reference (nm 'U msys_crt0').
  #   gcrt0.o  — the -pg profiling startup (gcrt0.c): it does NOT call msys_crt0;
  #              it DEFINES `_monstartup` (nm 'T _monstartup'). Gating it on
  #              msys_crt0 would be wrong — check its own symbol instead.
  local _sym _grep
  for _o in crt0.o gcrt0.o; do
    if [ "${_o}" = "crt0.o" ]; then
      _sym="msys_crt0";   _grep="U msys_crt0"      # undefined ref into the runtime
    else
      _sym="_monstartup"; _grep=" T _monstartup"   # defined profiling ctor
    fi
    _s="$(find "${_rb}" -name "${_o}" 2>/dev/null | head -1)"
    if [ -z "${_s}" ]; then
      echo "FATAL: ${_o} not found in ${_rb} — the runtime build did not produce it."
      echo "       Refusing to package: a missing crt0 would leave the sysroot STUB in place."
      exit 1
    fi
    if ! aarch64-pc-cygwin-nm "${_s}" | grep -q "${_grep}"; then
      echo "FATAL: ${_s} does NOT have expected symbol '${_sym}' — it looks like the bootstrap STUB."
      echo "       Shipping it would make every aarch64-pc-cygwin exe hang at startup. Aborting."
      exit 1
    fi
    install -m644 "${_s}" "${pkgdir}/usr/aarch64-pc-cygwin/lib/${_o}"
    echo "packaged REAL ${_o} (has ${_sym})"
  done

  # --- runtime import lib + the libcygwin alias the build system links against
  _s="$(find "${_rb}" -name libmsys-2.0.a 2>/dev/null | head -1)"
  if [ -z "${_s}" ]; then
    echo "FATAL: libmsys-2.0.a not found in ${_rb} — runtime import lib missing. Aborting."
    exit 1
  fi
  install -m644 "${_s}" "${pkgdir}/usr/aarch64-pc-cygwin/lib/libmsys-2.0.a"
  ln -sf libmsys-2.0.a "${pkgdir}/usr/aarch64-pc-cygwin/lib/libcygwin.a"
  echo "packaged libmsys-2.0.a (+ libcygwin.a alias)"

  # --- newlib libs (Phase 2): fold libc/libm/libg into this package so the
  # sysroot's newlib libs come from a package, not a hand-copy out of src/.
  # libc.a/libm.a are mandatory. libg.a is a LEGACY "debug libc" that modern
  # newlib frequently does not emit — package it if present, else skip (not fatal).
  for _o in libc.a libm.a; do
    _s="$(find "${_rb}" -name "${_o}" 2>/dev/null | head -1)"
    if [ -z "${_s}" ]; then
      echo "FATAL: ${_o} not found in ${_rb} — newlib did not build. Aborting."
      exit 1
    fi
    install -m644 "${_s}" "${pkgdir}/usr/aarch64-pc-cygwin/lib/${_o}"
    echo "packaged ${_o}"
  done
  _s="$(find "${_rb}" -name libg.a 2>/dev/null | head -1)"
  if [ -n "${_s}" ]; then
    install -m644 "${_s}" "${pkgdir}/usr/aarch64-pc-cygwin/lib/libg.a"
    echo "packaged libg.a"
  else
    echo "note: libg.a not built by newlib (legacy debug libc) — skipping (not fatal)"
  fi

  # --- native ARM64 msys-2.0.dll (shipped under the sysroot; not executed on the x64 host)
  # The winsup Makefile's default target LINKS the DLL as `new-msys-2.0.dll` and only
  # renames it to the final `msys-2.0.dll` on `make install` — which this package build
  # (makepkg -e: build() runs `make`, then package(); no `make install`) does NOT run.
  # So on a CLEAN tree only `new-msys-2.0.dll` exists; a plain `msys-2.0.dll` shows up
  # only when a prior full/testinst build left one behind (works-on-dirty / fails-clean).
  # `new-msys-2.0.dll` IS the real linked DLL (install just strips+renames it), so accept
  # `msys-2.0.dll` if present, else fall back to `new-msys-2.0.dll`, and ship it as the
  # final name.
  install -d "${pkgdir}/usr/aarch64-pc-cygwin/bin"
  _s="$(find "${_rb}" -name msys-2.0.dll 2>/dev/null | head -1)"
  if [ -z "${_s}" ]; then
    _s="$(find "${_rb}" -name new-msys-2.0.dll 2>/dev/null | head -1)"
    [ -n "${_s}" ] && echo "note: using freshly-linked new-msys-2.0.dll (no installed msys-2.0.dll on a clean tree)"
  fi
  if [ -z "${_s}" ]; then
    echo "FATAL: neither msys-2.0.dll nor new-msys-2.0.dll found in ${_rb} — the runtime DLL was not built. Aborting."
    exit 1
  fi
  install -m755 "${_s}" "${pkgdir}/usr/aarch64-pc-cygwin/bin/msys-2.0.dll"
  echo "packaged msys-2.0.dll (from $(basename "${_s}"))"

  # --- native ARM64 cygcheck (issue #37, epic #36) ------------------------------
  # cygcheck is a MinGW host tool (a native PE; it does NOT link the msys runtime,
  # it LoadLibrary's msys-2.0.dll at runtime). The winsup build is configured
  # --disable-utils, so `make` never builds it; compile it directly with the same
  # aarch64-w64-mingw32 toolchain + flags/libs as winsup/utils/mingw/Makefile.am
  # (cygcheck_SOURCES + cygcheck_LDADD). This is the exact compile the runtime CI
  # gate (cygwin.yml "Validate cygcheck (native ARM64)") proves each run. The
  # compiler (mingw-w64-cross-mingwarm64-gcc), -lz (…-zlib) and CRT (…-crt) are
  # already makedepends of this package. STRICT: any failure is a hard exit 1.
  ( cd "${srcdir}/${_realname}/winsup" && aarch64-w64-mingw32-g++ \
      -fno-exceptions -fno-rtti -fno-use-cxa-atexit \
      -Wall -Wstrict-aliasing -Wwrite-strings -fno-common -pipe -fbuiltin -fmessage-length=0 \
      -Wimplicit-fallthrough=4 -Werror -D_WIN32_WINNT=0x0a00 -DNTDDI_VERSION=WDK_NTDDI_VERSION \
      -I utils -idirafter cygwin/include \
      utils/mingw/bloda.cc utils/mingw/cygcheck.cc utils/mingw/dump_setup.cc utils/mingw/path.cc \
      -o "${srcdir}/cygcheck.exe" -static -Wl,--disable-high-entropy-va \
      -lz -lwininet -lshlwapi -lpsapi -lntdll ) \
    || { echo "FATAL: cygcheck.exe failed to compile for aarch64-w64-mingw32. Aborting."; exit 1; }
  case "$(file "${srcdir}/cygcheck.exe")" in
    *ARM64*|*Aarch64*|*aarch64*) : ;;
    *) echo "FATAL: cygcheck.exe is not an ARM64 PE: $(file "${srcdir}/cygcheck.exe")"; exit 1 ;;
  esac
  install -m755 "${srcdir}/cygcheck.exe" "${pkgdir}/usr/aarch64-pc-cygwin/bin/cygcheck.exe"
  echo "packaged native ARM64 cygcheck.exe"

  # --- native ARM64 cygwin-console-helper (issue #38, epic #36) -----------------
  # Unlike cygcheck above, this MinGW host tool is built by `make` in build()
  # (runtime configured --enable-mingw-utils), exactly as the native x86_64 runtime
  # builds it — no hand-written compile line. Just install the automake output.
  # STRICT: missing exe or wrong arch is a hard exit 1.
  _cch="${srcdir}/runtime-build/utils/mingw/cygwin-console-helper.exe"
  [ -f "${_cch}" ] \
    || { echo "FATAL: ${_cch} not found — 'make' did not build the MinGW host tools. Aborting."; exit 1; }
  case "$(file "${_cch}")" in
    *ARM64*|*Aarch64*|*aarch64*) : ;;
    *) echo "FATAL: cygwin-console-helper.exe is not an ARM64 PE: $(file "${_cch}")"; exit 1 ;;
  esac
  install -m755 "${_cch}" "${pkgdir}/usr/aarch64-pc-cygwin/bin/cygwin-console-helper.exe"
  echo "packaged native ARM64 cygwin-console-helper.exe (built via make)"

  # --- native ARM64 ldh (issue #39, epic #36) -----------------------------------
  # ldh (load-DLL helper; used by cygcheck's BLODA scan) is another MinGW host tool
  # built by `make` in build() via --enable-mingw-utils. Install the automake output.
  # (The runtime CI gate for #39 landed via #75; this install was intended for
  # packages #12 but that PR merged into the orphaned #11 branch, so it never
  # reached ci/cross-runtime-packaging — carried here instead.)
  # STRICT: missing exe or wrong arch is a hard exit 1.
  _ldh="${srcdir}/runtime-build/utils/mingw/ldh.exe"
  [ -f "${_ldh}" ] \
    || { echo "FATAL: ${_ldh} not found — 'make' did not build the MinGW host tools. Aborting."; exit 1; }
  case "$(file "${_ldh}")" in
    *ARM64*|*Aarch64*|*aarch64*) : ;;
    *) echo "FATAL: ldh.exe is not an ARM64 PE: $(file "${_ldh}")"; exit 1 ;;
  esac
  install -m755 "${_ldh}" "${pkgdir}/usr/aarch64-pc-cygwin/bin/ldh.exe"
  echo "packaged native ARM64 ldh.exe (built via make)"

  # --- native ARM64 getprocaddrarm64 (issue #42, epic #36) ----------------------
  # The gentle-kill helper. Built by `make` via HAVE_MINGWARM64_CC. Installs into
  # libexec (NOT bin): the runtime spawns it as /usr/libexec/getprocaddrarm64.exe
  # (winsup/cygwin/include/cygwin/exit_process.h). STRICT: hard exit 1 on failure.
  _gpa="${srcdir}/runtime-build/utils/mingw/getprocaddrarm64.exe"
  [ -f "${_gpa}" ] \
    || { echo "FATAL: ${_gpa} not found — 'make' did not build getprocaddrarm64 (no aarch64 MinGW gcc?). Aborting."; exit 1; }
  case "$(file "${_gpa}")" in
    *ARM64*|*Aarch64*|*aarch64*) : ;;
    *) echo "FATAL: getprocaddrarm64.exe is not an ARM64 PE: $(file "${_gpa}")"; exit 1 ;;
  esac
  install -d "${pkgdir}/usr/aarch64-pc-cygwin/libexec"
  install -m755 "${_gpa}" "${pkgdir}/usr/aarch64-pc-cygwin/libexec/getprocaddrarm64.exe"
  echo "packaged native ARM64 getprocaddrarm64.exe (built via make, -> libexec)"

  # --- cygwin-linked utils (issues #43-#67, epic #36 Part B) --------------------
  # Install every Part-B util that actually built in build() (first-pass discovery;
  # some may not compile yet — non-fatal here, the CI smoke gate is authoritative).
  # cygps installs as ps (the Makefile `transform = s/cygps/ps/`). dumper (#68) is
  # out of scope (--disable-dumper). Source dir = runtime-build/utils/*.exe.
  _ub="${srcdir}/runtime-build/utils"
  _partb_ok=0; _partb_missing=""
  for u in chattr cygpath gencat getconf getfacl gmondump kill ldd locale lsattr \
           minidumper mkgroup mkpasswd mount newgrp passwd pldd profiler regtool \
           setfacl setmetamode ssp tzset umount; do
    if [ -f "${_ub}/${u}.exe" ]; then
      install -m755 "${_ub}/${u}.exe" "${pkgdir}/usr/aarch64-pc-cygwin/bin/${u}.exe"
      _partb_ok=$((_partb_ok+1))
    else
      _partb_missing="${_partb_missing} ${u}"
    fi
  done
  # cygps -> ps (install-time rename, matches the winsup Makefile transform)
  if [ -f "${_ub}/cygps.exe" ]; then
    install -m755 "${_ub}/cygps.exe" "${pkgdir}/usr/aarch64-pc-cygwin/bin/ps.exe"
    _partb_ok=$((_partb_ok+1))
  else
    _partb_missing="${_partb_missing} cygps(ps)"
  fi
  echo "packaged ${_partb_ok}/25 cygwin-linked Part-B utils"
  # NOTE: must NOT be a bare `[ ... ] && echo` as the LAST statement of package().
  # makepkg runs package() under `shopt -o -s errexit errtrace` with `trap ... ERR`,
  # so the function's exit status is that of its final command. When every util
  # builds, _partb_missing is empty, the test returns 1, package() returns 1, and
  # makepkg aborts with "A failure occurred in package()" AFTER all the work
  # succeeded. Paradoxically it only failed on total success. Use if/fi so the
  # function always ends on a true command.
  if [ -n "${_partb_missing}" ]; then
    echo "  not built (see CI smoke gate):${_partb_missing}"
  fi
  return 0
}


