_target=aarch64-pc-cygwin
_sysroot=/usr/${_target}

# Header supplying the utsname layout for the aarch64-pc-cygwin sysroot.
_utsname_hdr="winsup/cygwin/include/sys/utsname.h"

prepare() {
  # Our AArch64 enablement, carried as patches rather than a fork branch: a
  # branch moves, so the build was not reproducible and the delta from upstream
  # was invisible without cloning the fork and diffing it.  Same series, same
  # order and same base commit as msys2-runtime-aarch64{,-stage-2}.
  local _p
  for _p in "${srcdir}"/woarm64-*.patch; do
    msg2 "Applying $(basename "${_p}")"
    ( cd "${srcdir}/${_realname}" && git apply --whitespace=fix "${_p}" ) || return 1
  done

  # ABI guard.  struct utsname::sysname must be [_UTSNAME_LENGTH + 1], the
  # layout msys-2.0.dll is compiled against.  The old cygwin-dev source
  # declared it [_UTSNAME_LENGTH], a 1-byte mismatch that shifted every field
  # after sysname — uname(2) wrote utsname.machine at the DLL offset while
  # apps read it one byte earlier, so `uname -m` came back empty on ARM64.
  # msys2-runtime gets this right, so the sed below is now a no-op; the grep
  # after it is the part that matters and stays as a hard failure.
  local hdr="${srcdir}/${_realname}/${_utsname_hdr}"
  if grep -q 'char sysname\[_UTSNAME_LENGTH\][[:space:]]*;' "${hdr}"; then
    echo "prepare: patching utsname.h sysname -> _UTSNAME_LENGTH + 1 (runtime ABI)"
    sed -i 's/char sysname\[_UTSNAME_LENGTH\][[:space:]]*;/char sysname[_UTSNAME_LENGTH + 1];/' "${hdr}"
  fi
  grep -q 'char sysname\[_UTSNAME_LENGTH + 1\];' "${hdr}" \
    || { echo "ERROR: utsname.h sysname not sized to _UTSNAME_LENGTH + 1"; return 1; }
}

package() {
  _sysroot_bare=/usr/${_target}
  _sysroot_usr=/usr/${_target}/usr

  mkdir -p ${pkgdir}/${_sysroot_bare}/sys-include
  mkdir -p ${pkgdir}/${_sysroot_bare}/include
  mkdir -p ${pkgdir}/${_sysroot_usr}/sys-include
  mkdir -p ${pkgdir}/${_sysroot_usr}/include

  # newlib headers FIRST (base layer)
  for dest in \
    ${pkgdir}/${_sysroot_bare}/sys-include \
    ${pkgdir}/${_sysroot_bare}/include \
    ${pkgdir}/${_sysroot_usr}/sys-include \
    ${pkgdir}/${_sysroot_usr}/include; do
    cp -r ${srcdir}/${_realname}/newlib/libc/include/. ${dest}/
  done

  # cygwin headers SECOND (override layer)
  for dest in \
    ${pkgdir}/${_sysroot_bare}/sys-include \
    ${pkgdir}/${_sysroot_bare}/include \
    ${pkgdir}/${_sysroot_usr}/sys-include \
    ${pkgdir}/${_sysroot_usr}/include; do
    cp -r ${srcdir}/${_realname}/winsup/cygwin/include/. ${dest}/
  done

  # newlib's iconv.h and unctrl.h belong to libiconv and ncurses, and the
  # native msys2-runtime-devel ships neither.  The bare include directory
  # is searched before usr/include, so these copies would shadow the real
  # headers that libiconv and ncurses install there.
  for dest in \
    ${pkgdir}/${_sysroot_bare}/sys-include \
    ${pkgdir}/${_sysroot_bare}/include \
    ${pkgdir}/${_sysroot_usr}/sys-include \
    ${pkgdir}/${_sysroot_usr}/include; do
    rm -f ${dest}/iconv.h ${dest}/unctrl.h
  done

  # newlib.h and _newlib_version.h in newlib/libc/include are placeholders
  # ("Real file is created by newlib configuration").  Install the ones the
  # aarch64-pc-cygwin newlib configure generates for this source commit
  # (taken from the msys2-runtime-aarch64-stage-2 build), as the native
  # msys2-runtime-devel does; without them _HAVE_LONG_DOUBLE and the other
  # feature macros are undefined and strtold & co. are not declared.
  for dest in \
    ${pkgdir}/${_sysroot_bare}/sys-include \
    ${pkgdir}/${_sysroot_bare}/include \
    ${pkgdir}/${_sysroot_usr}/sys-include \
    ${pkgdir}/${_sysroot_usr}/include; do
    install -m644 ${srcdir}/newlib-aarch64.h ${dest}/newlib.h
    install -m644 ${srcdir}/_newlib_version-aarch64.h ${dest}/_newlib_version.h
  done

  echo "--- Header install check ---"
  [ -f ${pkgdir}/${_sysroot_bare}/include/stdio.h ] && \
    echo "bare/include/stdio.h OK" || echo "WARNING: bare/include/stdio.h MISSING"
  [ -f ${pkgdir}/${_sysroot_usr}/include/stdio.h ] && \
    echo "usr/include/stdio.h OK" || echo "WARNING: usr/include/stdio.h MISSING"
  grep -c "__aarch64__" \
    ${pkgdir}/${_sysroot_bare}/include/cygwin/signal.h 2>/dev/null && \
    echo "signal.h aarch64 OK" || echo "WARNING: signal.h missing aarch64"

  # ABI guard (hard fail): every installed copy of utsname.h must size
  # sysname to _UTSNAME_LENGTH + 1 so its field offsets match msys-2.0.dll.
  # A mismatch silently breaks uname(2).machine on ARM64 (see prepare()).
  local bad=0
  for uts in \
    ${pkgdir}/${_sysroot_bare}/sys-include/sys/utsname.h \
    ${pkgdir}/${_sysroot_bare}/include/sys/utsname.h \
    ${pkgdir}/${_sysroot_usr}/sys-include/sys/utsname.h \
    ${pkgdir}/${_sysroot_usr}/include/sys/utsname.h; do
    if grep -q 'char sysname\[_UTSNAME_LENGTH + 1\];' "${uts}"; then
      echo "utsname ABI OK: ${uts}"
    else
      echo "ERROR: wrong utsname sysname ABI in ${uts}"
      bad=1
    fi
  done
  [ "${bad}" -eq 0 ] || return 1
}
