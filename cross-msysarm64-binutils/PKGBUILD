        woarm64-0005-Allow-build-of-libsim-for-aarch64-w64-mingw32-and-aa.patch
        woarm64-0006-PE-COFF-AArch64-avoid-ADRP-for-ABS-small-constants.patch
        woarm64-0007-bfd-aarch64-PE-mark-handled-relocs-with-r_ignore.patch
        woarm64-0008-bfd-restore-the-section_htab-guards-removed-by-b3dcd.patch
