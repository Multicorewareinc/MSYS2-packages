# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=('apr-util' 'apr-util-devel')
pkgver=1.6.5
pkgrel=2
pkgdesc="The Apache Portable Runtime"
arch=('i686' 'x86_64' 'aarch64')
url="https://apr.apache.org/"
msys2_references=(
  "cpe: cpe:/a:apache:apr-util"
)
makedepends=('apr-devel' 'libexpat-devel' 'libsqlite-devel' 'autotools' 'gcc' 'libxcrypt-devel')
options=('!libtool')
license=('spdx:Apache-2.0')
source=("https://archive.apache.org/dist/apr/apr-util-${pkgver}.tar.bz2"
        plugins.patch)
sha256sums=('96de1dd6f6a0476d2d2e7964926d8c1ddc3bb0e210e1b1812d3ba5a454a392e2'
            '3280d6ed8e577b626e60d495856d16f6944c3144c495fe9ed8cad6b39332824c')

prepare() {
  cd "${srcdir}/apr-util-${pkgver}"

  patch -p1 -i ${srcdir}/plugins.patch

  autoreconf -fi
}

build() {
  cd "${srcdir}/apr-util-${pkgver}"

  # aarch64-pc-cygwin cross: --host selects the cross compiler, and apr,
  # expat and sqlite come from the sysroot (its apr-1-config reports
  # sysroot paths).
  local _xargs=(--build=${CHOST}) _p=/usr
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _p=/usr/aarch64-pc-cygwin/usr
    _xargs+=(--host=aarch64-pc-cygwin)
  fi

  export MSYSTEM=CYGWIN
  ./configure \
    "${_xargs[@]}" \
    --prefix=/usr \
    --with-apr=${_p} \
    --with-expat=${_p} \
    --without-gdbm \
    --without-ldap \
    --without-pgsql \
    --with-sqlite3=${_p}

  # (cross: apr's build helpers, libtool included, are in the sysroot)
  if [[ ${_p} != /usr ]]; then
    sed -i "s|/usr/share/apr/build-1|${_p}/share/apr/build-1|g" Makefile build/rules.mk
    # apu-1-config, unlike apr-1-config, cannot tell that it runs from a
    # sysroot, so serf and subversion got the host's -L/usr/lib (and ld
    # then choked on the x86 libmsys-2.0.a).  Give it apr-1-config's
    # check: run by a path that ends in $bindir but is not $bindir, it
    # prefixes its directories with what comes before.  Installed and run
    # as /usr/bin/apu-1-config it behaves as before.
    sed -i '/^location=/a\
case "$0" in\
  "${bindir}/"*) ;;\
  /*) _apu_root=${0%${bindir}/apu-1-config}\
      if test "$_apu_root" != "$0"; then\
        prefix=$_apu_root$prefix; exec_prefix=$_apu_root$exec_prefix\
        bindir=$_apu_root$bindir; libdir=$_apu_root$libdir\
        includedir=$_apu_root$includedir\
      fi ;;\
esac' apu-1-config
    grep -q '_apu_root' apu-1-config || { error "apu-1-config: sysroot check not added"; return 1; }
  fi

  make -j1
  make DESTDIR="${srcdir}/dest" install
}

check() {
  cd "${srcdir}/apr-util-${pkgver}"
  make -j1 check
}

package_apr-util() {
  depends=('apr' 'expat' 'libsqlite' 'libxcrypt')
  groups=('libraries')

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/*.dll ${pkgdir}/usr/bin/
}

package_apr-util-devel() {
  pkgdesc="Libapr-util headers and libraries"
  groups=('development')
  depends=("apr-util=${pkgver}" "apr-devel" "libexpat-devel" "libsqlite-devel")
  options=('staticlibs')

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/*-config ${pkgdir}/usr/bin/
  cp -rf ${srcdir}/dest/usr/include ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/lib ${pkgdir}/usr/
}
