# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=dos2unix
pkgver=7.5.7
pkgrel=2
pkgdesc='Text file format converter'
arch=('i686' 'x86_64' 'aarch64')
url='https://waterlander.net/dos2unix/'
license=('spdx:BSD-2-Clause')
depends=('libintl')
makedepends=('perl' 'gettext-devel' 'gcc' 'make')
conflicts=('hd2u')
source=("https://waterlander.net/${pkgname}/files/${pkgname}-${pkgver}.tar.gz")
sha256sums=('669ee27120ae71589f638fe3a167d6ea54f8633f5ab1b282551bd7a7c9510dfa')

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}
}

build() {
  cd ${srcdir}/${pkgname}-${pkgver}
  # aarch64-pc-cygwin cross: only the compiler changes; the Makefile picks
  # the MSYS settings from `uname` on both sides.
  local _xargs=()
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _xargs=(CC=aarch64-pc-cygwin-gcc)
  fi
  make DEBUG=1 "${_xargs[@]}"
}

package() {
  cd ${srcdir}/${pkgname}-${pkgver}
  make DESTDIR=${pkgdir} install
  install -Dm755 ${pkgdir}/usr/bin/dos2unix.exe ${pkgdir}/usr/bin/d2u.exe
  install -Dm755 ${pkgdir}/usr/bin/unix2dos.exe ${pkgdir}/usr/bin/u2d.exe
  install -D -m644 COPYING.txt ${pkgdir}/usr/share/licenses/${pkgname}/LICENSE
}
