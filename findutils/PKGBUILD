# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=findutils
pkgver=4.11.0
pkgrel=3
pkgdesc="GNU utilities to locate files"
arch=('i686' 'x86_64' 'aarch64')
license=('spdx:GPL-3.0-or-later')
depends=('libiconv' 'libintl')
makedepends=('libiconv-devel' 'gettext-devel' 'autotools' 'gcc')
url="https://www.gnu.org/software/findutils"
msys2_repository_url="https://cgit.git.savannah.gnu.org/cgit/findutils.git"
msys2_references=(
  "cpe: cpe:/a:gnu:findutils"
)

source=(https://ftp.gnu.org/pub/gnu/findutils/${pkgname}-${pkgver}.tar.xz{,.sig})
sha256sums=('bfd19cb06cc71f3352d567e90284d8cdac02ac89774bbeadf0b533b0c11432fd'
            'SKIP')
validpgpkeys=('0CF4E8D871593224842832B888DD9E08C5DDACB9')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  autoreconf -fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Don't build or install locate because we use mlocate,
  # which is a secure version of locate.
  # sed -i '/^SUBDIRS/s/locate//' Makefile.in

  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    # Cross-build for aarch64-pc-cygwin (see .ci/makepkg-aarch64-cross.conf).
    # libiconv and libintl are staged under the toolchain sysroot at
    # /usr/aarch64-pc-cygwin/usr by the packages built before this one.
    #
    # gnulib probes several behaviours with AC_RUN_IFELSE, which cannot run a
    # target binary on the x64 build host.  Seed the ones whose cross default
    # is wrong for this target, the same way coreutils does.
    #
    # -no-integrated-cpp: gl/lib/mountlist.c hangs cc1 forever otherwise -- no
    # diagnostic, no progress, at -O0 and -O2 alike, so it is the front end and
    # not the optimizer.  A separate cpp pass compiles it in seconds.  This is
    # the same GCC-17 AArch64 lex-while-parse bug msys2-runtime-aarch64 already
    # works around for libc/minires-os-if.o, reached here by a different file.
    # Applied package-wide rather than per-object because findutils has no
    # per-file rule hook; the cost is one extra process per translation unit.
    ./configure \
      --build=${CHOST} \
      --host=aarch64-pc-cygwin \
      --prefix=/usr \
      --without-libiconv-prefix \
      --without-libintl-prefix \
      --disable-year2038 \
      DEFAULT_ARG_SIZE="(32u*1024)" \
      gl_cv_func_strtod_works=yes \
      gl_cv_func_working_mktime=yes \
      CFLAGS="-std=gnu17 -no-integrated-cpp -I/usr/aarch64-pc-cygwin/usr/include" \
      LDFLAGS="${LDFLAGS} -L/usr/aarch64-pc-cygwin/usr/lib"
    make
    return
  fi

  local -a extra_config
  # 32-bit cygwin only has 32-bit time_t
  # https://github.com/msys2/MSYS2-packages/issues/4078
  if [[ "$CARCH" == "i686" ]]; then
    extra_config+=("--disable-year2038")
  fi

  ./configure \
    --build=${CHOST} \
    --prefix=/usr \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    "${extra_config[@]}" \
    DEFAULT_ARG_SIZE="(32u*1024)"

  make
}

check() {
  # target binaries cannot run on the x64 cross host
  [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]] && return 0
  cd "${srcdir}/${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR=${pkgdir} install
}
