# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=openssh
pkgver=10.5p1
pkgrel=4
pkgdesc='Free version of the SSH connectivity tools'
url='https://www.openssh.com/portable.html'
msys2_changelog_url="https://www.openssh.com/releasenotes.html"
msys2_references=(
  'archlinux: openssh'
  "cpe: cpe:/a:openbsd:openssh"
  'cygwin: openssh'
  'gentoo: net-misc/openssh'
)
license=('spdx:LicenseRef-OpenSSH')
arch=('i686' 'x86_64' 'aarch64')
groups=('net-utils')
depends=('heimdal' 'libedit' 'libxcrypt' 'libfido2' 'openssl')
makedepends=('heimdal-devel' 'libedit-devel' 'libxcrypt-devel' 'libfido2-devel' 'openssl-devel' 'autotools' 'gcc' 'groff')
source=("https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/${pkgname}-${pkgver}.tar.gz"{,.asc}
        openssh-7.3p1-msys2.patch
        openssh-7.3p1-msys2-setkey.patch
        openssh-7.3p1-msys2-drive-name-in-path.patch
        aarch64-reap-session-children.py)
sha256sums=('d44d28a839ea9daf969cc69150fde59910b2b39361dad81a3bd6cbd19218db11'
            'SKIP'
            '4ac8da8f0933eae61e3b973e627c0c152ea4168c28cdc27066f9a5d54432f578'
            '25079cf4a10c1ab70d60302bccaabee513762520dffd7c35285f7aae3ea36087'
            '903b3eee51e492a125cab9c724ad967450307d53e457f025e4432b81cb145af5'
            '8ff2d87be0c95cd064d0b28195498c82cd42362c5bff405bc24288aaf92eaadd')
validpgpkeys=('7168B983815A5EEF59A4ADFD2A3F414E736060BA') # Damien Miller <djm@mindrot.org>

backup=('etc/ssh/ssh_config' 'etc/ssh/sshd_config')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  patch -p1 -i ${srcdir}/openssh-7.3p1-msys2.patch
  patch -p1 -i ${srcdir}/openssh-7.3p1-msys2-setkey.patch
  patch -p1 -i ${srcdir}/openssh-7.3p1-msys2-drive-name-in-path.patch

  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    # sshd here intermittently misses the session child exiting, so the client
    # never receives exit-status and hangs.  See the script for measurements.
    python "${srcdir}/aarch64-reap-session-children.py"
  fi

  autoreconf -fvi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # setproctitle is new in Cygwin 3.6, and we want openssh
  # to work with older Cygwin versions too.
  export ac_cv_func_setproctitle=no
  # configure might detect arc4random_stir stub in older
  # Cygwin versions, which is not in header
  export ac_cv_func_arc4random_stir=no

  export MSYSTEM=CYGWIN
  TEST_SSH_UTF8=no \
  # aarch64-pc-cygwin cross: --host stops configure probing with the build
  # compiler, and kerberos5/libedit/openssl come from the toolchain sysroot.
  local _xargs=(--build=${CHOST})
  local _krb5=/usr
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    _xargs+=(--host=aarch64-pc-cygwin)
    _krb5=/usr/aarch64-pc-cygwin/usr
    CPPFLAGS+=" -I/usr/aarch64-pc-cygwin/usr/include"
    LDFLAGS+=" -L/usr/aarch64-pc-cygwin/usr/lib"
    # openssh hardcodes LIBS="$LIBS /usr/lib/textreadmode.o" for Cygwin.  That
    # is the host x86-64 object, so every configure link test fails with "file
    # format not recognized"; and the target one cannot simply be substituted
    # either, because our cross-built ncurses DLL exports cygwin_premain0 and
    # the two then collide:
    #   multiple definition of `cygwin_premain0'; libcurses.dll.a(...)
    # Drop it here and fix ncurses separately -- it should not be exporting
    # those symbols.  Without it openssh does not force text mode on stdio,
    # which is a behavioural difference from the native package.
    sed -i "s|LIBS=\"\$LIBS /usr/lib/textreadmode.o\"|:|" configure
  fi

  ./configure \
    "${_xargs[@]}" \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib/ssh \
    --sysconfdir=/etc/ssh \
    --localstatedir=/var \
    --with-libedit \
    --with-kerberos5=${_krb5} \
    --with-security-key-builtin \
    --without-hardening \
    --disable-strip

  make
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export MSYSTEM=CYGWIN
  make tests ||
  grep $USER /etc/passwd | grep -q /bin/false
  # connect.sh fails when run with stupid login shell
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm644 LICENCE "${pkgdir}/usr/share/licenses/${pkgname}/LICENCE"

  install -Dm755 contrib/findssl.sh "${pkgdir}"/usr/bin/findssl.sh
  install -Dm755 contrib/ssh-copy-id "${pkgdir}"/usr/bin/ssh-copy-id
  install -Dm644 contrib/ssh-copy-id.1 "${pkgdir}"/usr/share/man/man1/ssh-copy-id.1
}
